<Window
    x:Class="Charm.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Charm"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Charm"
    Width="1920"
    Height="1080"
    Loaded="OnControlLoaded"
    PreviewKeyDown="MainWindow_PreviewKeyDown"
    WindowState="Maximized"
    mc:Ignorable="d">
    <Grid Style="{DynamicResource GradientBackground}">

        <Grid
            x:Name="SpinnerContainer"
            Grid.RowSpan="2"
            Panel.ZIndex="0"
            Background="Transparent"
            Opacity="1"
            Visibility="Visible" />

        <StackPanel
            Margin="0,5,10,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Panel.ZIndex="1"
            Orientation="Horizontal">
            <Image
                x:Name="CharmIcon"
                Width="20"
                Height="20"
                Margin="0,0,5,0"
                VerticalAlignment="Center" />
            <TextBlock
                x:Name="CurrentStrategyText"
                VerticalAlignment="Center"
                FontFamily="{StaticResource MaterialDesignFont}"
                FontSize="16"
                Text="NO GAME SELECTED" />
        </StackPanel>

        <TabControl
            x:Name="MainTabControl"
            Background="Transparent"
            FontFamily="{StaticResource MaterialDesignFont}">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <DockPanel>
                            <!--  Customized TabPanel  -->
                            <TabPanel
                                x:Name="HeaderPanel"
                                Margin="0,0,0,0"
                                Panel.ZIndex="1"
                                Background="#0D0D0D"
                                DockPanel.Dock="Top"
                                IsItemsHost="True" />

                            <!--  Content Presenter  -->
                            <ContentPresenter
                                x:Name="PART_SelectedContentHost"
                                Margin="0"
                                ContentSource="SelectedContent" />
                        </DockPanel>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>

            <TabItem
                x:Name="SettingsTab"
                HorizontalAlignment="Left"
                Header="SETTINGS">
                <local:ConfigView />
            </TabItem>
            <TabItem
                x:Name="Log"
                HorizontalAlignment="Left"
                Header="LOG">
                <local:LogView />
            </TabItem>
            <TabItem
                x:Name="MainMenuTab"
                HorizontalAlignment="Left"
                Header="MAIN MENU"
                IsSelected="True">
                <local:MainMenuView />
            </TabItem>
        </TabControl>

        <local:ProgressView
            x:Name="ProgressView"
            Grid.Row="0"
            Grid.RowSpan="2" />
    </Grid>
</Window>
