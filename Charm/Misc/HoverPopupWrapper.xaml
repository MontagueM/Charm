<UserControl
    x:Class="Charm.HoverPopupWrapper"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Charm"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="FloatingContainerStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="IsHitTestVisible" Value="True" />
            <Setter Property="Focusable" Value="True" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!--  The interactive target  -->
        <ContentPresenter x:Name="TargetHost" Content="{Binding Target, ElementName=Root}" />

        <!--  Needs to exist for content to actually show, idk why  -->
        <ContentPresenter
            Width="0"
            Height="0"
            Content="{Binding PopupContent, ElementName=Root}"
            Visibility="Hidden" />

    </Grid>
</UserControl>
