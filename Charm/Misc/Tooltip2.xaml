<UserControl
    x:Class="Charm.Tooltip2"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Charm"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:MinHeight="91"
    d:Visibility="Visible"
    d:Width="510"
    Focusable="False"
    Visibility="Collapsed"
    mc:Ignorable="d">
    <UserControl.Resources>
        <local:BlockColorSelector x:Key="BlockColorSelector" />
        <local:DamageTypeConverter x:Key="DamageTypeConverter" />

        <Style x:Key="BlockBackground" TargetType="Grid">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Opacity" Value="0.9" />
            <Setter Property="Background">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource BlockColorSelector}">
                        <Binding Path="BodyColorOverride" />
                        <Binding Path="DataContext.BodyColor" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ToolTipHeaderTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <Rectangle
                    x:Name="CategoryTopBar"
                    Grid.Row="0"
                    Height="5"
                    VerticalAlignment="Top"
                    Fill="#b6b6b6"
                    Opacity="0.9">
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HideTopBar}" Value="false">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>

                <Grid
                    Grid.Row="1"
                    Margin="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Visibility="{Binding Icon, Converter={StaticResource NullToVisibilityConverter}}">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Width" Value="27" />
                            <Setter Property="Height" Value="40" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsD1}" Value="True">
                                    <Setter Property="Width" Value="54" />
                                    <Setter Property="Height" Value="54" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Rectangle
                        Grid.Row="1"
                        Width="28"
                        Height="40"
                        Opacity="0.6"
                        Stretch="Fill"
                        Visibility="{Binding IsD1, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                <GradientStop Offset="0" Color="#00000000" />
                                <GradientStop Offset="1" Color="Black" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!--  Featured item banner  -->
                    <Polygon
                        Width="28"
                        Height="32"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Fill="#109191"
                        Points="0,0 0,32 14,28 28,32 28,0">
                        <Polygon.Style>
                            <Style TargetType="Polygon">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Hash, Converter={StaticResource Investment_IsFeaturedItem}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Polygon.Style>
                    </Polygon>

                    <Image
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Source="{Binding Icon}">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Margin" Value="3" />
                                <Setter Property="MaxWidth" Value="22" />
                                <Setter Property="MaxHeight" Value="22" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsD1}" Value="True">
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="MaxWidth" Value="54" />
                                        <Setter Property="MaxHeight" Value="54" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                </Grid>

                <Grid
                    Grid.Row="1"
                    Margin="20,10,20,10"
                    VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        x:Name="HeaderName"
                        Margin="0,0,0,0"
                        d:FontFamily="Haas Grot Text 65 Medium"
                        d:Text="ITEM NAME "
                        FontFamily="{DynamicResource Haas Grot Text 65 Medium}"
                        Foreground="{Binding TextColor, Converter={StaticResource ColorToBrush}}"
                        Text="{Binding Name}"
                        TextWrapping="WrapWithOverflow">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="34" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Style}" Value="Category">
                                        <Setter Property="FontSize" Value="24" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Grid Grid.Row="1" Visibility="{Binding Style, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Item}">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="{Binding Type, Converter={StaticResource StringNullOrEmptyVisibilityConverter}}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CollapseEmpty}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock
                                x:Name="HeaderType"
                                Margin="0,0,0,0"
                                VerticalAlignment="Center"
                                d:FontFamily="Haas Grot Text 55 Roman"
                                d:Text="Item Type"
                                FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                                FontSize="22"
                                Foreground="{Binding TextColor, Converter={StaticResource ColorToBrush}}"
                                Opacity="0.6"
                                Text="{Binding Type}"
                                TextWrapping="WrapWithOverflow" />

                            <TextBlock
                                x:Name="DamageType"
                                Margin="5,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Panel.ZIndex="1"
                                FontFamily="{DynamicResource Haas Grot Text 65 Medium Keys}"
                                FontSize="22"
                                Foreground="{Binding DamageType, Converter={StaticResource DamageTypeConverter}, ConverterParameter=Foreground}"
                                Text="{Binding DamageType, Converter={StaticResource DamageTypeConverter}, ConverterParameter=Text}"
                                Visibility="{Binding DamageType, Converter={StaticResource DamageTypeConverter}, ConverterParameter=Visibility}">
                                <TextBlock.Effect>
                                    <DropShadowEffect
                                        BlurRadius="4"
                                        Direction="-90"
                                        Opacity="0.5"
                                        ShadowDepth="0.5"
                                        Color="Black" />
                                </TextBlock.Effect>
                            </TextBlock>
                        </StackPanel>

                        <TextBlock
                            x:Name="HeaderLabel"
                            Grid.Row="1"
                            Margin="0,0,0,0"
                            HorizontalAlignment="Right"
                            d:FontFamily="Haas Grot Text 55 Roman"
                            d:Text="Label"
                            FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                            FontSize="22"
                            Foreground="{Binding LabelColor, Converter={StaticResource ColorToBrush}}"
                            Opacity="0.9"
                            Text="{Binding Label}"
                            TextWrapping="WrapWithOverflow">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="{Binding Label, Converter={StaticResource StringNullOrEmptyVisibilityConverter}}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CollapseEmpty}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:SpacerBlock}">
            <Grid Height="{Binding Height}">
                <Grid Style="{StaticResource BlockBackground}" />
                <Rectangle
                    Height="2"
                    VerticalAlignment="Top"
                    Fill="White"
                    Opacity="{Binding BarOpacity}"
                    Visibility="{Binding ShowBar, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:TextsBlock}">
            <Grid>
                <Grid Style="{StaticResource BlockBackground}" />
                <TextBlock
                    Margin="20,0,20,10"
                    VerticalAlignment="Top"
                    FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                    FontSize="22"
                    Foreground="{StaticResource ForegroundColour90}"
                    Opacity="0.8"
                    Text="{Binding Text}"
                    TextWrapping="Wrap"
                    Visibility="{Binding Text, Converter={StaticResource StringIsEmptyVisibilityConverter}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="{DynamicResource Haas Grot Text 55 Roman}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Italic}" Value="True">
                                    <Setter Property="FontFamily" Value="{DynamicResource Haas Grot Text 56 Italic}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

        </DataTemplate>

        <DataTemplate DataType="{x:Type local:EnergyModBlock}">
            <Grid>
                <Grid Style="{StaticResource BlockBackground}" />
                <Grid Margin="20,10,20,10">
                    <StackPanel
                        VerticalAlignment="Center"
                        Opacity="0.87"
                        Orientation="Horizontal">
                        <Border Margin="0,5,0,0" VerticalAlignment="Top">
                            <Image
                                Width="24"
                                Height="24"
                                Source="{Binding Icon}" />
                        </Border>

                        <TextBlock
                            Margin="2,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource Haas Grot Disp 75 Bold}"
                            FontSize="34"
                            Foreground="White"
                            Text="{Binding Cost}"
                            TextWrapping="WrapWithOverflow" />
                        <TextBlock
                            Margin="15,5,0,0"
                            VerticalAlignment="Top"
                            FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                            FontSize="22"
                            Foreground="{StaticResource ForegroundColour90}"
                            Text="ENERGY COST"
                            TextWrapping="WrapWithOverflow" />
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:PerkBlock}">
            <Grid>
                <Grid Style="{StaticResource BlockBackground}" />
                <Grid Margin="20,10,20,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Image
                        Grid.Column="0"
                        Width="40"
                        Height="40"
                        Margin="0,4,15,0"
                        VerticalAlignment="Top"
                        Source="{Binding Icon}" />

                    <TextBlock
                        Grid.Column="1"
                        Margin="0,0,0,0"
                        VerticalAlignment="Center"
                        FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                        FontSize="20"
                        Foreground="{StaticResource ForegroundColour90}"
                        Opacity=".7"
                        Text="{Binding Description}"
                        TextWrapping="WrapWithOverflow" />

                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:NotificationBlock}">
            <Grid>
                <Grid Style="{StaticResource BlockBackground}" />
                <Grid Margin="20,10,20,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Margin="0,-5,15,0">
                        <TextBlock
                            Grid.Column="0"
                            Width="40"
                            Height="40"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                            Foreground="{StaticResource ForegroundColour100}"
                            TextAlignment="Center"
                            TextWrapping="WrapWithOverflow">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="ⓘ" />
                                    <Setter Property="FontSize" Value="30" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Style}" Value="ItemAddon">
                                            <Setter Property="Text" Value="✦" />
                                            <Setter Property="FontSize" Value="38" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!--  ItemAddon style upper right star (this is dumb)  -->
                        <TextBlock
                            Grid.Column="0"
                            Width="40"
                            Height="40"
                            VerticalAlignment="Top"
                            FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                            FontSize="16"
                            Foreground="{StaticResource ForegroundColour100}"
                            Text="✦"
                            TextAlignment="Right"
                            TextWrapping="WrapWithOverflow">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Hidden" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Style}" Value="ItemAddon">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>


                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                        FontSize="20"
                        Text="{Binding Text}"
                        TextWrapping="WrapWithOverflow">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource ForegroundColour60}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Style}" Value="ItemAddon">
                                        <Setter Property="Foreground" Value="{StaticResource ForegroundColour70}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Style}" Value="PerkInfo">
                                        <Setter Property="Foreground" Value="{StaticResource ForegroundColour60}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:EmblemBlock}">
            <Grid>
                <Grid Style="{StaticResource BlockBackground}" />
                <Grid Margin="20,10,20,10">
                    <Image Source="{Binding Emblem}" />
                </Grid>
            </Grid>
        </DataTemplate>

        <!--  Objectives  -->
        <DataTemplate DataType="{x:Type local:ObjectiveBlock}">
            <Grid>
                <Grid Style="{StaticResource BlockBackground}" />
                <Grid Background="#1c1c1c" Opacity="0.85" />
                <StackPanel Orientation="Vertical">
                    <TextBlock
                        Margin="20,2,0,2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontFamily="{DynamicResource Haas Grot Text 65 Medium Keys}"
                        FontSize="20"
                        Foreground="#5ca369"
                        TextWrapping="WrapWithOverflow"
                        Visibility="{Binding IsInterval, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Run Text="STEP" />
                        <Run Text="{Binding IntervalIndex}" />
                    </TextBlock>

                    <ContentControl Content="{Binding}" ContentTemplateSelector="{DynamicResource ObjBlockTemplateSelector}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <!--  End Objective  -->

        <!--  Rewards  -->
        <DataTemplate DataType="{x:Type local:RewardBlock}">
            <Grid>
                <Grid Style="{StaticResource BlockBackground}" />

                <!--  "Triumph Completed Rewards"  -->
                <Grid Background="Transparent" Visibility="{Binding RewardOnComplete, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Rectangle
                        Height="2"
                        VerticalAlignment="Top"
                        Fill="White"
                        Opacity="0.2" />
                    <Grid Margin="20,15,20,10">
                        <StackPanel Orientation="Vertical">
                            <TextBlock
                                Margin="0,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontFamily="{DynamicResource Haas Grot Text 65 Medium Keys}"
                                FontSize="22"
                                Foreground="#e3d488"
                                Opacity="0.85"
                                Text="TRIUMPH COMPLETED REWARDS:"
                                TextWrapping="WrapWithOverflow" />

                            <ItemsControl
                                Margin="0,5,0,0"
                                ItemTemplateSelector="{DynamicResource RewardItemTemplateSelector}"
                                ItemsSource="{Binding Rewards}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel
                                            Grid.Row="0"
                                            Width="auto"
                                            Height="auto"
                                            Margin="0,0,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Margin" Value="0,0,0,4" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>

                </Grid>

                <!--  Standard rewards  -->
                <Grid
                    Margin="20,10,20,10"
                    Background="Transparent"
                    Visibility="{Binding RewardOnComplete, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock
                            Margin="0,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource Haas Grot Text 65 Medium Keys}"
                            FontSize="22"
                            Foreground="#5ca369"
                            Text="REWARDS:"
                            TextWrapping="WrapWithOverflow" />

                        <ItemsControl
                            Margin="0,5,0,0"
                            ItemTemplateSelector="{DynamicResource RewardItemTemplateSelector}"
                            ItemsSource="{Binding Rewards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel
                                        Grid.Row="0"
                                        Width="auto"
                                        Height="auto"
                                        Margin="0,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Margin" Value="0,0,0,3" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Grid>

        </DataTemplate>

        <DataTemplate x:Key="InventoryItemRewardTemplate">
            <Grid Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    MaxWidth="40"
                    MaxHeight="40"
                    Margin="0,0,10,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    d:Source="https://www.bungie.net/common/destiny2_content/icons/c577890c4a2d81e3c4ce1c803cdb9a3b.png"
                    Source="{Binding Icon}">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>

                <TextBlock
                    Grid.Column="1"
                    Margin="0,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                    FontSize="22"
                    Foreground="{StaticResource ForegroundColour100}"
                    Opacity="0.8"
                    Text="{Binding ItemName}"
                    TextWrapping="WrapWithOverflow" />
            </Grid>

        </DataTemplate>

        <DataTemplate x:Key="EmblemRewardTemplate">
            <Grid Background="Transparent">
                <TextBlock
                    Margin="90,5,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Panel.ZIndex="1"
                    FontFamily="{DynamicResource Haas Grot Text 65 Medium Keys}"
                    FontSize="24"
                    Foreground="{StaticResource ForegroundColour95}"
                    Text="{Binding ItemName}"
                    TextWrapping="WrapWithOverflow">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect
                                        BlurRadius="2"
                                        Direction="-90"
                                        Opacity="0.5"
                                        ShadowDepth="1.5"
                                        Color="#1B1B1B" />
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Image Source="{Binding LargeIcon}" />
            </Grid>
        </DataTemplate>

        <local:ItemTemplateSelector
            x:Key="RewardItemTemplateSelector"
            Template1="{StaticResource InventoryItemRewardTemplate}"
            Template2="{StaticResource EmblemRewardTemplate}" />
        <!--  End Rewards  -->

        <!--  Input items  -->
        <DataTemplate DataType="{x:Type local:InputBlock}">
            <Grid
                Margin="0,5,0,5"
                HorizontalAlignment="Right"
                Background="Transparent">
                <StackPanel FlowDirection="LeftToRight" Orientation="Horizontal">
                    <Grid Margin="15,0,0,0" Background="Transparent">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                            FontSize="20"
                            Foreground="{StaticResource ForegroundColour80}"
                            Text="{Binding Key}"
                            TextWrapping="WrapWithOverflow" />

                        <!--  Mainly for mouse input  -->
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                            FontSize="20"
                            Foreground="#3396DA"
                            Text="{Binding KeyPress}"
                            TextWrapping="WrapWithOverflow" />
                    </Grid>

                    <TextBlock
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                        FontSize="20"
                        Foreground="{StaticResource ForegroundColour80}"
                        Text="{Binding Action}"
                        TextWrapping="WrapWithOverflow" />
                </StackPanel>

            </Grid>
        </DataTemplate>

    </UserControl.Resources>

    <Grid
        x:Name="ToolTip"
        Width="510"
        HorizontalAlignment="Left"
        VerticalAlignment="Bottom"
        Panel.ZIndex="50"
        IsHitTestVisible="False"
        SnapsToDevicePixels="True">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="TooltipTranslate" X="0" Y="0" />
        </Grid.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <!--  Tooltip Header  -->
            <Grid Grid.Row="0">
                <Rectangle
                    d:Fill="#CC000000"
                    Fill="{Binding HeaderColor, Converter={StaticResource ColorToBrush}}"
                    Opacity="0.9" />
                <ContentControl
                    Margin="0"
                    Content="{Binding Header}"
                    ContentTemplate="{StaticResource ToolTipHeaderTemplate}" />
            </Grid>

            <!--  Tooltip Body  -->
            <Grid Grid.Row="1">
                <ItemsControl ItemsSource="{Binding BodyBlocks}" />
            </Grid>

            <!--  Tooltip Footer (inputs)  -->
            <Grid Grid.Row="2" Background="#E6000000">
                <ItemsControl Margin="20,0,20,0" ItemsSource="{Binding InputBlocks}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel
                                HorizontalAlignment="Right"
                                Background="Transparent"
                                FlowDirection="RightToLeft"
                                Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="0,0,0,0" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </Grid>
        </Grid>
    </Grid>

</UserControl>
