<UserControl
    x:Class="Charm.Changelog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Charm"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="1017"
    d:DesignWidth="1920"
    KeyDown="UserControl_KeyDown"
    mc:Ignorable="d">
    <UserControl.Resources>
        <DataTemplate x:Key="ChangelogEntry">
            <RadioButton
                Margin="0,5,5,5"
                Click="ChangelogEntry_Click"
                GroupName="VersionButtons"
                MouseEnter="ChangelogEntry_MouseEnter"
                Style="{DynamicResource D2StyleRadioButton}"
                Visibility="{Binding IsPlaceholder, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <StackPanel
                    Margin="15,0,0,0"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{DynamicResource Haas Grot Text 65 Medium Keys}"
                        FontSize="32"
                        Foreground="{StaticResource ForegroundColour90}"
                        Text="{Binding Version}" />

                    <TextBlock
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontFamily="{DynamicResource Haas Grot Text 65 Medium Keys}"
                        FontSize="22"
                        Foreground="{StaticResource ForegroundColour50}"
                        Text="{Binding Date}" />
                </StackPanel>

            </RadioButton>
        </DataTemplate>

        <DataTemplate x:Key="ChangesTemplate">
            <StackPanel Margin="0,0,0,15" Orientation="Vertical">
                <TextBlock
                    Margin="0,0,0,0"
                    HorizontalAlignment="Left"
                    FontFamily="{DynamicResource Haas Grot Text 65 Medium Keys}"
                    FontSize="28"
                    Foreground="{StaticResource ForegroundColour100}"
                    Text="{Binding Title}" />

                <ItemsControl ItemsSource="{Binding Notes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                Margin="0,5,0,5"
                                HorizontalAlignment="Left"
                                d:FontFamily="Haas Grot Text 55 Roman"
                                FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                                FontSize="24"
                                Foreground="{StaticResource ForegroundColour70}"
                                Text="{Binding}"
                                TextWrapping="WrapWithOverflow" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>

        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="#D0000000">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Grid.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetProperty="Opacity"
                            From="0"
                            To="1"
                            Duration="0:0:0.25" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <Button
            Name="Exit"
            Width="50"
            Height="50"
            Margin="25"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Click="Exit_Click"
            Opacity="0.5"
            Style="{StaticResource D2StyleButton}">
            <TextBlock
                Margin="0,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                d:FontFamily="Haas Grot Text 55 Roman"
                FontFamily="{DynamicResource Haas Grot Text 65 Medium Keys}"
                FontSize="36"
                Foreground="{StaticResource ForegroundColour90}"
                Text="X" />
        </Button>

        <Grid Margin="100,75,100,100">
            <Grid.RowDefinitions>
                <RowDefinition Height="15*" />
                <RowDefinition Height="90*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock
                    Margin="0,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    d:FontFamily="Haas Grot Text 55 Roman"
                    FontFamily="{DynamicResource Haas Grot Text 65 Medium Keys}"
                    FontSize="46"
                    Foreground="{StaticResource ForegroundColour90}"
                    Text=" CHANGELOG" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20*" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="70*" />
                </Grid.ColumnDefinitions>

                <local:ItemPage
                    x:Name="ChangelogVersions"
                    Grid.Column="0"
                    CollapsePageButtons="True"
                    Columns="1"
                    IsVertical="True"
                    ItemTemplate="{StaticResource ChangelogEntry}"
                    ItemsPerPage="10"
                    UsePlaceholders="True" />

                <Border
                    Grid.Column="1"
                    Height="auto"
                    Margin="50,0,50,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    BorderBrush="White"
                    BorderThickness="1,0,1,0"
                    Opacity=".5"
                    Visibility="Visible" />

                <Grid
                    x:Name="ChangeLogPanel"
                    Grid.Column="2"
                    Visibility="Hidden">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <StackPanel
                        Margin="0,-5,0,25"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="-10,0,10,0"
                            VerticalAlignment="Center"
                            d:FontFamily="Haas Grot Text 55 Roman"
                            FontFamily="{DynamicResource Haas Grot Text 65 Medium Keys}"
                            FontSize="64"
                            Foreground="#e0ca48"
                            Text="" />
                        <TextBlock
                            VerticalAlignment="Center"
                            d:FontFamily="Haas Grot Text 55 Roman"
                            FontFamily="{DynamicResource Haas Grot Text 65 Medium Keys}"
                            FontSize="48"
                            Foreground="#e0ca48"
                            Text="{Binding Version}" />
                    </StackPanel>


                    <Grid Grid.Row="1" Margin="0,0,0,0">

                        <ScrollViewer
                            Grid.Row="1"
                            Grid.ColumnSpan="1"
                            Margin="0,0,100,0"
                            HorizontalAlignment="Stretch"
                            Background="Transparent"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Resources>
                                <Style BasedOn="{StaticResource BorderedScrollBar}" TargetType="ScrollBar">
                                    <Setter Property="Width" Value="7" />
                                </Style>
                            </ScrollViewer.Resources>
                            <StackPanel>
                                <ItemsControl
                                    Margin="0,0,25,0"
                                    Background="Transparent"
                                    ItemTemplate="{StaticResource ChangesTemplate}"
                                    ItemsSource="{Binding Changes}"
                                    KeyboardNavigation.TabNavigation="None"
                                    ScrollViewer.CanContentScroll="False"
                                    VirtualizingPanel.IsContainerVirtualizable="True"
                                    VirtualizingPanel.ScrollUnit="Pixel">

                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>


        </Grid>
    </Grid>

</UserControl>
