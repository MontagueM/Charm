<UserControl
    x:Class="Charm.ActivityListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Charm"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
    xmlns:wrap="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
    d:DesignHeight="990"
    d:DesignWidth="1920"
    Loaded="OnControlLoaded"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="ActivityCategoryTemplate">
            <RadioButton
                Margin="0"
                local:StyleHelper.BorderThickness="1"
                Checked="ActivityCategory_Checked"
                Focusable="False"
                Foreground="Transparent"
                GroupName="ActivityCategory"
                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                Style="{DynamicResource D2StyleRadioButtonNoOverlay}">
                <Grid>
                    <Border BorderBrush="{Binding CategoryColor, Converter={StaticResource ColorMultiplyConverter}, ConverterParameter=1}" BorderThickness="2">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="False">
                                        <Setter Property="Background" Value="{Binding CategoryColor, Converter={StaticResource ColorMultiplyConverter}, ConverterParameter=0.25}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Background" Value="{Binding CategoryColor, Converter={StaticResource ColorMultiplyConverter}, ConverterParameter=0.5}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <Polygon
                        Margin="2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Fill="White"
                        Points="0,25 0,0 25,0">
                        <Polygon.Style>
                            <Style TargetType="Polygon">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="False">
                                        <Setter Property="Opacity" Value="0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Opacity" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Polygon.Style>
                    </Polygon>

                    <Grid Margin="25,20,25,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="90*" />
                        </Grid.ColumnDefinitions>
                        <Image
                            Width="34"
                            Height="34"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Source="{Binding CategoryIcon}"
                            Visibility="Visible">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CategoryIcon}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>

                        <TextBlock
                            Grid.Column="1"
                            Margin="15,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            d:FontFamily="Haas Grot Text 55 Roman"
                            FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                            FontSize="24"
                            Foreground="{StaticResource ForegroundColour100}"
                            Text="{Binding CategoryName}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="False">
                                            <Setter Property="Opacity" Value="0.75" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                </Grid>

            </RadioButton>
        </DataTemplate>

        <DataTemplate x:Key="ActivityTemplate">
            <Button
                MaxHeight="128"
                Margin="0,0,0,0"
                HorizontalAlignment="Stretch"
                local:StyleHelper.BorderThickness="1"
                Click="ActivityItem_Click"
                Style="{DynamicResource D2StyleButtonNoOverlay}">
                <Grid>
                    <Border
                        Background="{Binding ActivityColor, Converter={StaticResource ColorMultiplyConverter}, ConverterParameter=0.33}"
                        BorderBrush="{Binding ActivityColor, Converter={StaticResource ColorMultiplyConverter}, ConverterParameter=1}"
                        BorderThickness="2" />
                    <Grid Margin="25,5,25,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <Image
                            Grid.Column="0"
                            Width="36"
                            Height="36"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Source="{Binding ActivityIcon}" />

                        <Grid Grid.Column="1" Margin="15,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Margin="0,5,0,5"
                                HorizontalAlignment="Left"
                                d:FontFamily="Haas Grot Text 55 Roman"
                                FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                                FontSize="18"
                                Foreground="{StaticResource ForegroundColour90}"
                                Text="{Binding ActivityDestination}" />

                            <TextBlock
                                Grid.Row="1"
                                Margin="0,5,0,5"
                                HorizontalAlignment="Left"
                                d:FontFamily="Haas Grot Text 55 Roman"
                                FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                                FontSize="18"
                                Foreground="{StaticResource ForegroundColour70}"
                                Text="{Binding ActivityName}" />

                            <TextBlock
                                Grid.Row="1"
                                Margin="0,5,0,5"
                                HorizontalAlignment="Right"
                                d:FontFamily="Haas Grot Text 55 Roman"
                                FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                                FontSize="14"
                                Foreground="{StaticResource ForegroundColour60}">
                                <Run Text="{Binding ActivityDestinationDev}" />
                                <Run Text=" : " />
                                <Run Text="{Binding ActivityHashString}" />
                            </TextBlock>
                        </Grid>

                    </Grid>
                </Grid>
            </Button>
        </DataTemplate>

        <Style x:Name="StaticListViewItem" TargetType="ListViewItem">
            <Setter Property="Margin" Value="5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                        <Border
                            x:Name="ButtonBackground"
                            Background="Transparent"
                            BorderBrush="{StaticResource BackgroundColour30}"
                            BorderThickness="0">
                            <ContentPresenter Margin="0" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Grid.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetProperty="Opacity"
                            From="0"
                            To="1"
                            Duration="0:0:0.25" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>


        <Grid x:Name="MainContainer" Background="Transparent">
            <Grid.RenderTransform>
                <TranslateTransform />
            </Grid.RenderTransform>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="25*" />
                <ColumnDefinition Width="50*" />
                <ColumnDefinition Width="25*" />
            </Grid.ColumnDefinitions>

            <Grid Margin="10" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="5*" />
                    <RowDefinition Height="95*" />
                </Grid.RowDefinitions>

                <TextBox
                    x:Name="ActivitySearchBox"
                    Margin="15,0,25,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    FontSize="30"
                    TextChanged="ActivitySearchBox_TextChanged"
                    TextWrapping="Wrap" />

                <Border
                    Grid.RowSpan="2"
                    Margin="0,15,0,15"
                    BorderBrush="{StaticResource ForegroundColour70}"
                    BorderThickness="0,0,1,0" />

                <ListView
                    x:Name="ActivityCategoryList"
                    Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemTemplate="{StaticResource ActivityCategoryTemplate}"
                    VirtualizingPanel.IsVirtualizing="True">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel
                                Grid.Row="0"
                                Width="auto"
                                Height="auto"
                                Margin="10,5,10,5"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                Background="Transparent"
                                Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                </ListView>
            </Grid>

            <Grid
                Grid.Column="1"
                Margin="0,10,0,10"
                Background="Transparent">

                <Grid.RowDefinitions>
                    <RowDefinition Height="5*" />
                    <RowDefinition Height="95*" />
                </Grid.RowDefinitions>

                <StackPanel
                    x:Name="FilterOptions"
                    Grid.Row="0"
                    Margin="0,0,0,0"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal">
                    <TextBox
                        x:Name="ActivityItemSearchBox"
                        Grid.Row="0"
                        Width="500"
                        Margin="10,0,10,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        FontSize="30"
                        TextChanged="ActivityItemSearchBox_TextChanged"
                        TextWrapping="Wrap" />

                </StackPanel>

                <ListView
                    x:Name="ActivityList"
                    Grid.Row="1"
                    Margin="0,10,0,5"
                    Background="Transparent"
                    BorderBrush="{StaticResource ForegroundColour70}"
                    BorderThickness="0,0,1,0"
                    ItemTemplate="{StaticResource ActivityTemplate}"
                    Style="{DynamicResource StaticListViewItem}"
                    VirtualizingPanel.IsContainerVirtualizable="True"
                    VirtualizingPanel.ScrollUnit="Pixel">

                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel HorizontalAlignment="Stretch" Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                </ListView>
            </Grid>

            <Grid
                Grid.Row="1"
                Grid.Column="2"
                Background="Transparent">
                <TextBlock
                    x:Name="PreBlWarn"
                    Grid.Row="0"
                    Margin="25"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    d:FontFamily="Haas Grot Text 55 Roman"
                    FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                    FontSize="18"
                    Foreground="{StaticResource ForegroundColour60}"
                    Text="Warning: The concept of Activities in comparison to Post-Beyond Light Destiny 2 don't exist in the traditional sense.&#x0a;&#x0a;In Pre-Beyond Light D2 and D1, maps themselves hold all the activities. This is why you will only see Destinations instead of activities for the current version."
                    TextWrapping="WrapWithOverflow"
                    Visibility="Collapsed" />
            </Grid>
        </Grid>

    </Grid>
</UserControl>
