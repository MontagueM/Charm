<UserControl
    x:Class="Charm.WeaponAudioListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Charm"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wrap="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
    d:DesignHeight="990"
    d:DesignWidth="1920"
    Loaded="OnControlLoaded"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="CategoryHeader">
            <Grid Opacity="0.5">
                <Grid.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="Opacity"
                                    To="1"
                                    Duration="0:0:0.075" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>

                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="Opacity"
                                    To="0.5"
                                    Duration="0:0:0.075" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Grid.Triggers>

                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,0,5"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Panel.ZIndex="1"
                            FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                            FontSize="22"
                            Foreground="White"
                            Text="{Binding Name}" />

                        <Button
                            Grid.Row="1"
                            Margin="15,0,0,5"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Click="BulkExportCategoryButton_Click"
                            Style="{StaticResource D2StyleButton}">
                            <local:GenericTooltipProperties.TooltipData>
                                <local:GenericTooltip Name="EXPORT ALL" Description="Export all sounds from this category." />
                            </local:GenericTooltipProperties.TooltipData>
                            <TextBlock
                                Margin="5"
                                VerticalAlignment="Center"
                                FontSize="12"
                                IsHitTestVisible="False"
                                Text="EXPORT ALL"
                                TextAlignment="Center" />
                        </Button>
                    </StackPanel>

                    <Border
                        Margin="0,0,0,0"
                        BorderBrush="White"
                        BorderThickness="0,0,0,3"
                        Focusable="False" />
                </StackPanel>
            </Grid>

        </DataTemplate>

        <DataTemplate x:Key="WeaponItemTemplate">
            <RadioButton
                Margin="0,0,0,0"
                local:StyleHelper.BorderThickness="1"
                Checked="WeaponItem_Checked"
                Focusable="False"
                Foreground="Transparent"
                GroupName="WeaponItem"
                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                Style="{DynamicResource D2StyleRadioButton}">
                <StackPanel Background="{StaticResource BackgroundColour14a}">
                    <TextBlock
                        Margin="15,10,15,10"
                        HorizontalAlignment="Left"
                        d:FontFamily="Haas Grot Text 55 Roman"
                        FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                        FontSize="18"
                        Foreground="{StaticResource ForegroundColour100}"
                        Text="{Binding Name}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <!--  Trigger when IsSelected (IsChecked) is false  -->
                                    <DataTrigger Binding="{Binding IsSelected}" Value="False">
                                        <Setter Property="Opacity" Value="0.75" />
                                    </DataTrigger>
                                    <!--  Trigger when IsSelected (IsChecked) is true  -->
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Opacity" Value="1.0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock
                        Margin="15,5,15,10"
                        HorizontalAlignment="Left"
                        d:FontFamily="Haas Grot Text 55 Roman"
                        FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                        FontSize="16"
                        Foreground="{StaticResource ForegroundColour70}">
                        <Run Text="{Binding Rarity}" />
                        <Run Text="{Binding Type}" />
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <!--  Trigger when IsSelected (IsChecked) is false  -->
                                    <DataTrigger Binding="{Binding IsSelected}" Value="False">
                                        <Setter Property="Opacity" Value="0.75" />
                                    </DataTrigger>
                                    <!--  Trigger when IsSelected (IsChecked) is true  -->
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Opacity" Value="1.0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

            </RadioButton>
        </DataTemplate>

        <DataTemplate x:Key="AudioTemplate">
            <RadioButton
                Width="550"
                MaxHeight="128"
                Margin="0,0,0,0"
                HorizontalAlignment="Left"
                local:StyleHelper.BorderThickness="1"
                Checked="Audio_OnClick"
                GroupName="AudioItem"
                Style="{DynamicResource D2StyleRadioButton}">
                <Border Background="{StaticResource BackgroundColour14a}">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="5" Orientation="Vertical">
                            <TextBlock
                                Margin="0"
                                HorizontalAlignment="Left"
                                d:FontFamily="Haas Grot Text 55 Roman"
                                FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                                FontSize="16"
                                Foreground="{StaticResource ForegroundColour70}"
                                Text="{Binding DisplayHash}" />

                            <TextBlock
                                Margin="0"
                                HorizontalAlignment="Left"
                                d:FontFamily="Haas Grot Text 55 Roman"
                                FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                                FontSize="16"
                                Foreground="{StaticResource ForegroundColour70}">
                                <Run Text="Duration: " />
                                <Run Text="{Binding Duration}" />
                            </TextBlock>

                            <TextBlock
                                Margin="0"
                                HorizontalAlignment="Left"
                                d:FontFamily="Haas Grot Text 55 Roman"
                                FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                                FontSize="16"
                                Foreground="{StaticResource ForegroundColour70}">
                                <Run Text="Sample Rate: " />
                                <Run Text="{Binding SampleRate}" />
                            </TextBlock>

                            <TextBlock
                                Margin="0"
                                HorizontalAlignment="Left"
                                d:FontFamily="Haas Grot Text 55 Roman"
                                FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                                FontSize="16"
                                Foreground="{StaticResource ForegroundColour70}">
                                <Run Text="Channels: " />
                                <Run Text="{Binding Channels}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                </Border>
            </RadioButton>
        </DataTemplate>

        <DataTemplate x:Key="WeaponAudioCategory">
            <Grid
                Width="600"
                Margin="0,0,0,0"
                HorizontalAlignment="Left">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ContentControl
                    Grid.Row="0"
                    Margin="0,5,0,5"
                    Content="{Binding}"
                    ContentTemplate="{StaticResource CategoryHeader}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Margin" Value="0,0,0,0" />
                        </Style>
                    </ContentControl.Style>
                </ContentControl>

                <Grid Grid.Row="1" VerticalAlignment="Top">
                    <ListView
                        Grid.Row="1"
                        MaxHeight="210"
                        Margin="0,5,0,5"
                        Background="Transparent"
                        BorderBrush="{StaticResource ForegroundColour70}"
                        BorderThickness="0,0,1,0"
                        Focusable="True"
                        ItemTemplate="{StaticResource AudioTemplate}"
                        ItemsSource="{Binding Sounds}"
                        SelectionChanged="AudioList_SelectionChanged"
                        Style="{DynamicResource AudioListViewItem}"
                        VirtualizingPanel.IsContainerVirtualizable="True"
                        VirtualizingPanel.ScrollUnit="Pixel" />
                </Grid>

            </Grid>
        </DataTemplate>

        <Style x:Name="AudioListViewItem" TargetType="ListViewItem">
            <Setter Property="Margin" Value="5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                        <Border
                            x:Name="ButtonBackground"
                            Background="Transparent"
                            BorderBrush="{StaticResource BackgroundColour30}"
                            BorderThickness="0">
                            <ContentPresenter Margin="0" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Grid.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetProperty="Opacity"
                            From="0"
                            To="1"
                            Duration="0:0:0.25" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>


        <Grid x:Name="MainContainer" Background="Transparent">
            <Grid.RenderTransform>
                <TranslateTransform />
            </Grid.RenderTransform>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="450*" />
                <ColumnDefinition Width="725*" />
                <ColumnDefinition Width="750*" />
            </Grid.ColumnDefinitions>

            <Grid Margin="10,10,10,10" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="5*" />
                    <RowDefinition Height="95*" />
                </Grid.RowDefinitions>
                <Border
                    Grid.RowSpan="2"
                    Margin="0,15,0,15"
                    BorderBrush="{StaticResource ForegroundColour70}"
                    BorderThickness="0,0,1,0" />

                <TextBox
                    x:Name="SearchBox"
                    Grid.Row="0"
                    Margin="15,0,15,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    FontSize="30"
                    TextChanged="SearchBox_TextChanged"
                    TextWrapping="Wrap" />

                <ListView
                    x:Name="WeaponListView"
                    Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemTemplate="{StaticResource WeaponItemTemplate}">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid
                                Grid.Row="0"
                                Width="auto"
                                Height="auto"
                                Margin="10,5,10,5"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                Background="Transparent"
                                Columns="1" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                </ListView>

            </Grid>

            <Grid
                Grid.Column="1"
                Margin="0,10,0,10"
                Background="Transparent">

                <Grid.RowDefinitions>

                    <RowDefinition Height="95*" />
                </Grid.RowDefinitions>

                <StackPanel
                    x:Name="FilterOptions"
                    Grid.Row="0"
                    Margin="0,0,0,0"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal"
                    Visibility="Collapsed">
                    <TextBox
                        x:Name="AudioSearchBox"
                        Grid.Row="0"
                        Width="250"
                        Margin="10,0,10,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        FontSize="30"
                        TextChanged="AudioSearchBox_TextChanged"
                        TextWrapping="Wrap" />

                </StackPanel>


                <ListView
                    x:Name="WeaponAudioEntries"
                    Grid.Row="1"
                    Margin="0,10,0,5"
                    Background="Transparent"
                    BorderBrush="{StaticResource ForegroundColour70}"
                    BorderThickness="0,0,1,0"
                    ItemTemplate="{StaticResource WeaponAudioCategory}"
                    KeyboardNavigation.DirectionalNavigation="None"
                    ScrollViewer.CanContentScroll="False"
                    Style="{DynamicResource AudioListViewItem}" />
            </Grid>

            <Grid Grid.Column="2" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="95*" />
                    <RowDefinition Height="10*" />
                </Grid.RowDefinitions>

                <ContentControl
                    x:Name="WaveformLoading"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Template="{StaticResource SpinningCircleTemplate}"
                    Visibility="Collapsed" />

                <Grid
                    Name="WaveformContainer"
                    Grid.ColumnSpan="3"
                    Margin="15"
                    VerticalAlignment="Center"
                    Panel.ZIndex="10"
                    Background="Transparent">

                    <Rectangle
                        x:Name="WaveformProgressBar"
                        Width="0"
                        MaxHeight="720"
                        Fill="#009BFB"
                        Opacity="1">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="{Binding Source, ElementName=Waveform}" Stretch="Uniform" />
                        </Rectangle.OpacityMask>
                        <Rectangle.Clip>
                            <RectangleGeometry x:Name="WaveformTintClip" />
                        </Rectangle.Clip>
                    </Rectangle>

                    <Image
                        x:Name="Waveform"
                        Grid.Row="0"
                        MaxHeight="720"
                        Panel.ZIndex="-10"
                        IsHitTestVisible="False"
                        Stretch="Uniform" />
                </Grid>


                <local:MusicPlayerControl
                    x:Name="MusicPlayer"
                    Grid.Row="0"
                    Height="100"
                    VerticalAlignment="Bottom"
                    Visibility="Visible" />

                <StackPanel
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Orientation="Horizontal">
                    <Border Margin="5" Background="{StaticResource BackgroundColour20}">
                        <Button
                            x:Name="ExportButton"
                            Click="ExportButton_Click"
                            IsEnabled="False"
                            Style="{StaticResource D2StyleButton}">
                            <local:GenericTooltipProperties.TooltipData>
                                <local:GenericTooltip Name="EXPORT" Description="Export the current sound." />
                            </local:GenericTooltipProperties.TooltipData>
                            <TextBlock
                                Margin="5"
                                VerticalAlignment="Center"
                                FontSize="22"
                                IsHitTestVisible="False"
                                Text="EXPORT CURRENT"
                                TextAlignment="Center" />
                        </Button>
                    </Border>

                    <Border Margin="5" Background="{StaticResource BackgroundColour20}">
                        <Button
                            x:Name="BulkExportButton"
                            Grid.Row="1"
                            Click="BulkExportButton_Click"
                            IsEnabled="False"
                            Style="{StaticResource D2StyleButton}">
                            <local:GenericTooltipProperties.TooltipData>
                                <local:GenericTooltip Name="EXPORT ALL" Description="Export all sounds for this weapon." />
                            </local:GenericTooltipProperties.TooltipData>
                            <TextBlock
                                Margin="5"
                                VerticalAlignment="Center"
                                FontSize="22"
                                IsHitTestVisible="False"
                                Text="EXPORT ALL"
                                TextAlignment="Center" />
                        </Button>
                    </Border>

                    <Border
                        Margin="5"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Background="{StaticResource BackgroundColour20}">
                        <Button
                            x:Name="ExportWaveform"
                            Click="ExportWaveform_Click"
                            IsEnabled="False"
                            Style="{StaticResource D2StyleButton}">
                            <local:GenericTooltipProperties.TooltipData>
                                <local:GenericTooltip Name="EXPORT" Description="Export the current sounds waveform as an image." />
                            </local:GenericTooltipProperties.TooltipData>
                            <TextBlock
                                Margin="5"
                                VerticalAlignment="Center"
                                FontSize="22"
                                IsHitTestVisible="False"
                                Text="EXPORT WAVEFORM"
                                TextAlignment="Center" />
                        </Button>
                    </Border>
                </StackPanel>

            </Grid>
        </Grid>

    </Grid>
</UserControl>
