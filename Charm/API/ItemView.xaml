<UserControl
    x:Class="Charm.ItemView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Charm"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="990"
    d:DesignWidth="1920"
    Focusable="True"
    KeyDown="UserControl_KeyDown"
    KeyboardNavigation.ControlTabNavigation="None"
    KeyboardNavigation.DirectionalNavigation="None"
    KeyboardNavigation.TabNavigation="None"
    Loaded="UserControl_Loaded"
    mc:Ignorable="d">

    <UserControl.Resources>
        <local:RarityBannerConverter x:Key="RarityBannerConverter" />
        <local:PercentageConverter x:Key="PercentageConverter" />
        <local:MarginConverter x:Key="MarginConverter" />
        <local:SignToBooleanConverter x:Key="SignToBooleanConverter" />
        <local:FlipSignPercentageConverter x:Key="FlipSignPercentageConverter" />

        <DataTemplate x:Key="CategoryHeader">
            <Grid
                MouseEnter="ItemTooltip_MouseEnter"
                MouseLeave="ItemTooltip_MouseLeave"
                Opacity="0.5">
                <Grid.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="Opacity"
                                    To="1"
                                    Duration="0:0:0.075" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>

                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="Opacity"
                                    To="0.5"
                                    Duration="0:0:0.075" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Grid.Triggers>

                <StackPanel Orientation="Vertical">
                    <TextBlock
                        Margin="0,0,0,5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Panel.ZIndex="1"
                        FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                        FontSize="22"
                        Foreground="White"
                        Text="{Binding CategoryName, Converter={StaticResource StringToUpperConverter}}" />
                    <Border
                        Margin="0,0,0,0"
                        BorderBrush="White"
                        BorderThickness="0,0,0,3"
                        Focusable="False" />
                </StackPanel>
            </Grid>

        </DataTemplate>

        <!--  Reusable  -->
        <Style x:Key="ReusableScrollBar" TargetType="ScrollBar">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Grid HorizontalAlignment="Stretch">
                            <Border
                                Grid.RowSpan="3"
                                Background="White"
                                CornerRadius="0"
                                Focusable="False"
                                Opacity="0.2" />
                            <Track
                                x:Name="PART_Track"
                                Grid.Row="1"
                                HorizontalAlignment="Stretch"
                                IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb
                                        Margin="0,0,0,0"
                                        Padding="0"
                                        Background="White"
                                        Opacity="0.3" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ReusableScrollViewer" TargetType="{x:Type ScrollViewer}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid Margin="0,0,0,0">
                            <!--  Content presenter (scrollable content)  -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="2" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <ScrollContentPresenter
                                x:Name="PART_ScrollContentPresenter"
                                Grid.Row="0"
                                Grid.Column="0"
                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />

                            <!--  Vertical ScrollBar  -->
                            <ScrollBar
                                x:Name="PART_VerticalScrollBar"
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="5,0,-5,0"
                                BorderThickness="0"
                                Maximum="{TemplateBinding ScrollableHeight}"
                                Orientation="Vertical"
                                Style="{StaticResource ReusableScrollBar}"
                                ViewportSize="{TemplateBinding ViewportHeight}"
                                Visibility="Visible"
                                Value="{TemplateBinding VerticalOffset}" />


                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ReusableButton" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent" Cursor="Hand">
                            <Border
                                x:Name="MainOverlay"
                                Panel.ZIndex="-1"
                                Background="Transparent"
                                CornerRadius="100"
                                Focusable="False">
                                <ContentPresenter Margin="1" />
                            </Border>
                            <Border
                                x:Name="outerBorder"
                                Margin="8"
                                BorderBrush="#D9FFFFFF"
                                BorderThickness="1.5"
                                CornerRadius="100"
                                Focusable="False"
                                IsHitTestVisible="False"
                                Opacity="0" />

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <Storyboard>
                                            <ColorAnimation
                                                Storyboard.TargetName="MainOverlay"
                                                Storyboard.TargetProperty="Background.(SolidColorBrush.Color)"
                                                To="Transparent"
                                                Duration="0:0:0.075" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="outerBorder"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0"
                                                Duration="0:0:0.075" />
                                            <ThicknessAnimation
                                                Storyboard.TargetName="outerBorder"
                                                Storyboard.TargetProperty="Margin"
                                                To="0"
                                                Duration="0:0:0.075" />
                                        </Storyboard>
                                    </VisualState>

                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <ColorAnimation
                                                Storyboard.TargetName="MainOverlay"
                                                Storyboard.TargetProperty="Background.(SolidColorBrush.Color)"
                                                To="#30FFFFFF"
                                                Duration="0:0:0.075" />
                                            <DoubleAnimation
                                                BeginTime="0:0:0.075"
                                                Storyboard.TargetName="outerBorder"
                                                Storyboard.TargetProperty="Opacity"
                                                To="1"
                                                Duration="0:0:0.075" />
                                            <ThicknessAnimation
                                                Storyboard.TargetName="outerBorder"
                                                Storyboard.TargetProperty="Margin"
                                                To="-5"
                                                Duration="0:0:0.075" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.Setters>
                                    <Setter Property="Cursor" Value="Hand" />
                                </Trigger.Setters>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ReusableEntry">
            <Grid
                Width="96"
                Height="96"
                Background="Transparent">
                <RadioButton
                    Width="80"
                    Height="80"
                    local:StyleHelper.BorderThickness="0.75"
                    local:StyleHelper.CornerRadius="100"
                    Checked="PlugItem_Checked"
                    Focusable="False"
                    GroupName="{Binding Index}"
                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                    MouseEnter="PlugItem_MouseEnter"
                    MouseLeave="PlugItem_MouseLeave"
                    Style="{StaticResource ReusableButton}">
                    <Grid>
                        <Border
                            BorderThickness="0"
                            CornerRadius="100"
                            Focusable="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <!--  Trigger when IsSelected (IsChecked) is false  -->
                                        <DataTrigger Binding="{Binding IsSelected}" Value="False">
                                            <Setter Property="Background" Value="Transparent" />
                                        </DataTrigger>
                                        <!--  Trigger when IsSelected (IsChecked) is true  -->
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="#cc62aadd" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Image
                                Width="60"
                                Height="60"
                                Margin="0"
                                Source="{Binding Icon}" />
                        </Border>
                        <Border
                            BorderBrush="#66FFFFFF"
                            BorderThickness="2"
                            CornerRadius="100"
                            Focusable="False" />

                        <Border
                            x:Name="EnhancedBorder"
                            Margin="0"
                            Padding="0"
                            BorderBrush="#eade8b"
                            BorderThickness="1.5"
                            CornerRadius="100">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="0,1">
                                    <GradientStop Offset="1" Color="#eade8b" />
                                    <GradientStop Offset="0" Color="#00EADE8B" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Item.Type, Converter={StaticResource StringContainsConverter}, ConverterParameter=Enhanced}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </Grid>

                </RadioButton>
            </Grid>

        </DataTemplate>
        <DataTemplate x:Key="ReusableSocket">
            <Grid MaxHeight="192">
                <Grid Panel.ZIndex="-1">
                    <Grid.Background>
                        <VisualBrush
                            Stretch="Uniform"
                            TileMode="Tile"
                            Viewport="25,25,25,25"
                            ViewportUnits="Absolute">
                            <VisualBrush.Visual>
                                <Rectangle
                                    Width="25"
                                    Height="25"
                                    Fill="Transparent"
                                    Opacity="0.025"
                                    Stroke="White" />
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Grid.Background>
                </Grid>

                <ScrollViewer Style="{StaticResource ReusableScrollViewer}">
                    <!--  Not a fan of the -2 margin but the slight gap is bothering me  -->
                    <ItemsControl
                        Margin="0,0,-2,0"
                        Background="Transparent"
                        ItemTemplate="{StaticResource ReusableEntry}"
                        ItemsSource="{Binding PlugItems}"
                        KeyboardNavigation.TabNavigation="None"
                        ScrollViewer.CanContentScroll="False"
                        VirtualizingPanel.IsContainerVirtualizable="True"
                        VirtualizingPanel.ScrollUnit="Pixel">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>


                </ScrollViewer>
            </Grid>

        </DataTemplate>
        <!--  End Reusable  -->

        <!--  Consumable  -->
        <DataTemplate x:Key="ConsumableEntry">
            <Grid Margin="0,0,0,0" Background="Transparent">
                <Grid Focusable="False" IsHitTestVisible="False">
                    <Border
                        Width="12"
                        Height="12"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="1,0,0,1"
                        Focusable="False" />

                    <Border
                        Width="12"
                        Height="12"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="1,1,0,0"
                        Focusable="False" />

                    <Border
                        Width="12"
                        Height="12"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="0,0,1,1"
                        Focusable="False" />

                    <Border
                        Width="12"
                        Height="12"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="0,1,1,0"
                        Focusable="False" />
                </Grid>
                <Grid Visibility="{Binding IsPlaceholder, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <Image
                        Width="96"
                        Height="96"
                        Margin="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Source="{Binding Icon}" />

                    <RadioButton
                        Width="96"
                        Height="96"
                        local:StyleHelper.BorderThickness="0.75"
                        Checked="PlugItem_Checked"
                        Focusable="False"
                        GroupName="{Binding Index}"
                        IsChecked="{Binding IsSelected, Mode=TwoWay}"
                        IsHitTestVisible="True"
                        MouseEnter="PlugItem_MouseEnter"
                        MouseLeave="PlugItem_MouseLeave"
                        MouseRightButtonDown="Consumable_RightClick"
                        Style="{StaticResource D2StyleRadioButtonNoSelectedOverlay}" />
                    <Border
                        BorderThickness="3"
                        Focusable="False"
                        Style="{StaticResource GreyBorderWhiteOnHover}">
                        <Grid
                            Width="22"
                            Height="48"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Visibility="{Binding ItemWatermark, Converter={StaticResource NullToVisibilityConverter}}">
                            <Rectangle
                                Grid.Row="1"
                                Width="22"
                                Height="48"
                                Opacity="0.6"
                                Stretch="Fill">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                        <GradientStop Offset="0" Color="#00000000" />
                                        <GradientStop Offset="1" Color="Black" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Image
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Source="{Binding ItemWatermark}" />
                        </Grid>
                    </Border>

                    <Border
                        x:Name="EnhancedBorder"
                        Margin="0"
                        Padding="0"
                        BorderBrush="#eade8b"
                        BorderThickness="1"
                        IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="0,1">
                                <GradientStop Offset="1" Color="#eade8b" />
                                <GradientStop Offset="0" Color="#00EADE8B" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Item.Type}" Value="Enhanced Trait">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ConsumableSocket">
            <Grid MaxHeight="96" Margin="0,0,0,10">
                <local:HoverPopupWrapper PopupParent="{x:Type local:SocketCategory}">
                    <local:HoverPopupWrapper.Target>
                        <ContentControl
                            Grid.Row="0"
                            Margin="0,0,0,0"
                            Content="{Binding SelectedPlug}"
                            ContentTemplate="{StaticResource ConsumableEntry}" />
                    </local:HoverPopupWrapper.Target>
                    <local:HoverPopupWrapper.PopupContent>
                        <Grid Margin="0,5,0,0">
                            <Grid.Effect>
                                <DropShadowEffect
                                    BlurRadius="10"
                                    Direction="0"
                                    ShadowDepth="0"
                                    Color="#905C5C5C" />
                            </Grid.Effect>

                            <local:ItemPage
                                Margin="-40,0,0,0"
                                CollapsePageButtons="False"
                                Columns="7"
                                ItemMargin="4"
                                ItemTemplate="{StaticResource ConsumableEntry}"
                                Items="{Binding PlugItems}"
                                ItemsPerPage="14"
                                PageBackgroundColor="#53616164"
                                SelectOnPageChange="False"
                                SlideDistance="10"
                                TransitionSpeed="0.125"
                                UsePlaceholders="True" />
                        </Grid>

                    </local:HoverPopupWrapper.PopupContent>
                </local:HoverPopupWrapper>
            </Grid>
        </DataTemplate>
        <!--  End Consumbable  -->

        <!--  Large Perk  -->
        <DataTemplate x:Key="LargePerkEntry">
            <Grid
                MinHeight="96"
                Margin="0,0,0,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Height="96" VerticalAlignment="Top">
                    <Border
                        Width="12"
                        Height="12"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="1,0,0,1" />

                    <Border
                        Width="12"
                        Height="12"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="1,1,0,0" />

                    <Border
                        Width="12"
                        Height="12"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="0,0,1,1" />

                    <Border
                        Width="12"
                        Height="12"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="0,1,1,0" />
                </Grid>

                <Border
                    Height="96"
                    VerticalAlignment="Top"
                    BorderBrush="#1DFFFFFF"
                    BorderThickness="1">
                    <Image
                        Width="78"
                        Height="78"
                        Margin="0"
                        Source="{Binding Icon}" />
                </Border>

                <Grid Grid.Column="1" Margin="20,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Panel.ZIndex="1"
                        FontFamily="{DynamicResource Haas Grot Text 65 Medium Keys}"
                        FontSize="22"
                        Foreground="{StaticResource ForegroundColour100}"
                        Opacity="1"
                        Text="{Binding Item.Name, Converter={StaticResource StringToUpperConverter}}"
                        TextWrapping="WrapWithOverflow">
                        <TextBlock.Effect>
                            <DropShadowEffect
                                BlurRadius="1"
                                Opacity="0.43"
                                ShadowDepth="3"
                                Color="Black" />
                        </TextBlock.Effect>
                    </TextBlock>

                    <TextBlock
                        Grid.Row="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Panel.ZIndex="1"
                        FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                        FontSize="22"
                        Foreground="{StaticResource ForegroundColour95}"
                        Opacity="0.9"
                        Text="{Binding Item.Description}"
                        TextWrapping="WrapWithOverflow">
                        <TextBlock.Effect>
                            <DropShadowEffect
                                BlurRadius="1"
                                Opacity="0.43"
                                ShadowDepth="3"
                                Color="Black" />
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>
            </Grid>

        </DataTemplate>
        <DataTemplate x:Key="LargePerkSocket">
            <Grid
                Width="725"
                MinHeight="98"
                Margin="0,0,0,25"
                Background="Transparent">
                <Grid Panel.ZIndex="-1">
                    <Grid.Background>
                        <VisualBrush
                            Stretch="Uniform"
                            TileMode="Tile"
                            Viewport="25,25,25,25"
                            ViewportUnits="Absolute">
                            <VisualBrush.Visual>
                                <Rectangle
                                    Width="25"
                                    Height="25"
                                    Fill="Transparent"
                                    Opacity="0.025"
                                    Stroke="White" />
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Grid.Background>
                </Grid>


                <local:ItemPage
                    CollapsePageButtons="True"
                    Columns="1"
                    ItemTemplate="{StaticResource LargePerkEntry}"
                    Items="{Binding PlugItems}"
                    ItemsPerPage="1" />

            </Grid>

        </DataTemplate>
        <!--  End Large Perk  -->

        <!--  Armor Perk Set  -->
        <DataTemplate x:Key="ArmorPerkSetEntry">
            <Grid
                MinHeight="96"
                Margin="0,10,0,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="80"
                    Height="80"
                    VerticalAlignment="Top"
                    BorderBrush="#FFFFFFFF"
                    BorderThickness="2"
                    CornerRadius="100"
                    Opacity="0.9">
                    <Image
                        Width="60"
                        Height="60"
                        Margin="0"
                        Source="{Binding Icon}" />
                </Border>

                <Grid Grid.Column="1" Margin="20,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Panel.ZIndex="1"
                        FontFamily="{DynamicResource Haas Grot Text 65 Medium Keys}"
                        FontSize="22"
                        Foreground="{StaticResource ForegroundColour100}"
                        Opacity="1"
                        Text="{Binding OverrideName, Converter={StaticResource StringToUpperConverter}}"
                        TextWrapping="WrapWithOverflow">
                        <TextBlock.Effect>
                            <DropShadowEffect
                                BlurRadius="1"
                                Opacity="0.43"
                                ShadowDepth="3"
                                Color="Black" />
                        </TextBlock.Effect>
                    </TextBlock>

                    <TextBlock
                        Grid.Row="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Panel.ZIndex="1"
                        FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                        FontSize="22"
                        Foreground="{StaticResource ForegroundColour90}"
                        Opacity="0.9"
                        Text="{Binding OverrideDescription}"
                        TextWrapping="WrapWithOverflow">
                        <TextBlock.Effect>
                            <DropShadowEffect
                                BlurRadius="1"
                                Opacity="0.43"
                                ShadowDepth="3"
                                Color="Black" />
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>
            </Grid>

        </DataTemplate>
        <DataTemplate x:Key="ArmorPerkSetSocket">
            <Grid
                Width="725"
                MinHeight="98"
                Margin="0,0,0,25"
                Background="Transparent">
                <Grid Panel.ZIndex="-1">
                    <Grid.Background>
                        <VisualBrush
                            Stretch="Uniform"
                            TileMode="Tile"
                            Viewport="25,25,25,25"
                            ViewportUnits="Absolute">
                            <VisualBrush.Visual>
                                <Rectangle
                                    Width="25"
                                    Height="25"
                                    Fill="Transparent"
                                    Opacity="0.025"
                                    Stroke="White" />
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Grid.Background>
                </Grid>

                <ItemsControl ItemTemplate="{StaticResource ArmorPerkSetEntry}" ItemsSource="{Binding PlugItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

            </Grid>

        </DataTemplate>
        <!--  End  Armor Perk Set  -->

        <!--  Socket Category  -->
        <local:SocketTemplateSelector
            x:Key="SocketTemplateSelector"
            ArmorPerkSetTemplate="{StaticResource ArmorPerkSetSocket}"
            ConsumableTemplate="{StaticResource ConsumableSocket}"
            LargePerkTemplate="{StaticResource LargePerkSocket}"
            ReusableTemplate="{StaticResource ReusableSocket}" />

        <DataTemplate x:Key="SocketCategory">
            <Grid
                Width="726"
                Margin="0,0,0,20"
                HorizontalAlignment="Left">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ContentControl
                    Grid.Row="0"
                    Content="{Binding}"
                    ContentTemplate="{StaticResource CategoryHeader}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Margin" Value="0,0,0,0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CategoryStyle}" Value="Consumable">
                                    <Setter Property="Margin" Value="0,0,215,0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>

                <Grid Grid.Row="1" VerticalAlignment="Top">
                    <ItemsControl
                        Margin="0,8,0,0"
                        ItemTemplateSelector="{StaticResource SocketTemplateSelector}"
                        ItemsSource="{Binding Sockets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel
                                    Grid.Row="0"
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Margin" Value="0,0,8,0" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </Grid>
            </Grid>
        </DataTemplate>
        <!--  End Socket Category  -->

        <!--  Stats  -->
        <DataTemplate DataType="{x:Type local:StatEntry}">
            <Grid
                Margin="0,0,0,1"
                HorizontalAlignment="Left"
                Background="Transparent"
                MouseEnter="ItemTooltip_MouseEnter"
                MouseLeave="ItemTooltip_MouseLeave">
