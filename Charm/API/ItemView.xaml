                                    Opacity="0.43"
                                    ShadowDepth="3"
                                    Color="Black" />
                            </TextBlock.Effect>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatAdjustValue}" Value="0">
                                            <Setter Property="Foreground" Value="Transparent" />
                                        </DataTrigger>

                                        <!--  If AdjustmentValue is positive, set Fill to Green  -->
                                        <DataTrigger Binding="{Binding StatAdjustValue, Converter={StaticResource SignToBooleanConverter}}" Value="True">
                                            <Setter Property="Foreground" Value="#99d695" />
                                        </DataTrigger>
                                        <!--  If AdjustmentValue is negative, set Fill to Red  -->
                                        <DataTrigger Binding="{Binding StatAdjustValue, Converter={StaticResource SignToBooleanConverter}}" Value="False">
                                            <Setter Property="Foreground" Value="#C64141" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                </Grid>

