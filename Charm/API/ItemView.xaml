                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Item.ItemDamageType}" Value="Arc">
                                                    <Setter Property="Foreground" Value="#85c5ec" />
                                                    <Setter Property="Text" Value=" Arc" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Item.ItemDamageType}" Value="Solar">
                                                    <Setter Property="Foreground" Value="#f2711b" />
                                                    <Setter Property="Text" Value=" Solar" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Item.ItemDamageType}" Value="Void">
                                                    <Setter Property="Foreground" Value="#b184c5" />
                                                    <Setter Property="Text" Value=" Void" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Item.ItemDamageType}" Value="Stasis">
                                                    <Setter Property="Foreground" Value="#4d88ff" />
                                                    <Setter Property="Text" Value=" Stasis" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Item.ItemDamageType}" Value="Strand">
                                                    <Setter Property="Foreground" Value="#35e366" />
                                                    <Setter Property="Text" Value=" Strand" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Border
                                    Grid.Column="1"
                                    Margin="50,0,25,0"
                                    BorderBrush="White"
                                    BorderThickness="2,0,0,0"
                                    Focusable="False"
                                    Opacity="0.5"
                                    Visibility="Visible" />

                                <StackPanel Grid.Column="2">
                                    <ItemsControl Margin="0,0,0,15" ItemsSource="{Binding StatEntries}" />

                                    <ItemsControl
                                        Margin="0,0,0,0"
                                        ItemTemplate="{StaticResource NumericStatEntry}"
                                        ItemsSource="{Binding NumericStatEntries}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>

                <!--  Appearance Subscreen indicator  -->
                <Grid
                    x:Name="AppearanceSubscreen"
                    Margin="0,0,0,10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Panel.ZIndex="3"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock
                            x:Name="SubscreenText"
                            Margin="0,0,0,5"
                            HorizontalAlignment="Center"
                            FontFamily="{DynamicResource Haas Grot Text 65 Medium}"
                            FontSize="20"
                            Foreground="White"
                            Opacity="0.8"
                            Text="A P P E A R A N C E">
                            <TextBlock.Effect>
                                <DropShadowEffect
                                    BlurRadius="1"
                                    Opacity="0.43"
                                    ShadowDepth="3"
                                    Color="Black" />
                            </TextBlock.Effect>
                        </TextBlock>

                        <Rectangle
                            Width="500"
                            Height="8"
                            Margin="0,0,0,5"
                            HorizontalAlignment="Stretch"
                            Opacity="0.5">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                                    <GradientStop x:Name="LeftStop" Offset="0" Color="Transparent" />
                                    <GradientStop x:Name="MiddleStop" Offset="0.5" Color="White" />
                                    <GradientStop x:Name="RightStop" Offset="1" Color="Transparent" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>

                            <Rectangle.Triggers>
                                <EventTrigger RoutedEvent="Rectangle.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                            <DoubleAnimation
                                                Storyboard.TargetName="LeftStop"
                                                Storyboard.TargetProperty="Offset"
                                                From="0"
                                                To="0.20"
                                                Duration="0:0:3">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>

                                            <DoubleAnimation
                                                Storyboard.TargetName="RightStop"
                                                Storyboard.TargetProperty="Offset"
                                                From="1"
                                                To="0.80"
                                                Duration="0:0:3">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Rectangle.Triggers>
                        </Rectangle>

                        <Polygon
                            x:Name="SubscreenArrowUp"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Fill="White"
                            Opacity="0.5"
                            Points="0, 0 50, 50, 0, 100"
                            Visibility="Hidden">
                            <Polygon.Style>
                                <Style TargetType="Polygon">
                                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                    <Setter Property="LayoutTransform">
                                        <Setter.Value>
                                            <TransformGroup>
                                                <ScaleTransform ScaleX="0.15" ScaleY="0.2" />
                                                <RotateTransform Angle="-90" />
                                            </TransformGroup>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Polygon.Style>
                        </Polygon>

                        <Grid Margin="0,2,0,2">
                            <TextBlock
                                Margin="0,0,25,0"
                                HorizontalAlignment="Center"
                                FontFamily="{DynamicResource Haas Grot Text 65 Medium Keys}"
                                FontSize="22"
                                Foreground="#2f2f2f"
                                Opacity="1"
                                Text="" />

                            <TextBlock
                                x:Name="SubscreenKey"
                                Margin="0,0,0,0"
                                HorizontalAlignment="Center"
                                FontFamily="{DynamicResource Haas Grot Text 65 Medium Keys}"
                                FontSize="22"
                                Foreground="White"
                                Opacity="0.8"
                                Text="" />
                        </Grid>


                        <Polygon
                            x:Name="SubscreenArrowDown"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Fill="White"
                            Opacity="0.5"
                            Points="0, 0 50, 50, 0, 100">
                            <Polygon.Style>
                                <Style TargetType="Polygon">
                                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                    <Setter Property="LayoutTransform">
                                        <Setter.Value>
                                            <TransformGroup>
                                                <ScaleTransform ScaleX="0.15" ScaleY="0.2" />
                                                <RotateTransform Angle="90" />
                                            </TransformGroup>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Polygon.Style>
                        </Polygon>
                    </StackPanel>

                </Grid>

                <!--  Item Lore  -->
                <Grid
                    x:Name="LoreEntry"
                    Width="880"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    Panel.ZIndex="5"
                    Background="#CC1B1C20"
                    Visibility="Collapsed">
                    <Border
                        BorderBrush="White"
                        BorderThickness="0,0,2,0"
                        Opacity="0.3" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="740" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="105" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="80" />
                        </Grid.RowDefinitions>

                        <!--  Item Name + upper border  -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                            <TextBlock
                                Margin="0,0,0,30"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Panel.ZIndex="1"
                                d:FontFamily="Haas Grot Text 65 Medium"
                                d:Text="IZANAGI'S BURDEN"
                                FontFamily="{DynamicResource Haas Grot Text 65 Medium Keys}"
                                FontSize="30"
                                FontWeight="Bold"
                                Foreground="{StaticResource ForegroundColour100}"
                                Opacity="0.9"
                                Text="{Binding Item.ItemName}"
                                Typography.CapitalSpacing="True" />

                            <Rectangle
                                Width="34"
                                Height="3"
                                HorizontalAlignment="Center"
                                Fill="White"
                                Opacity="0.3" />
                            <Rectangle
                                Width="740"
                                Height="1"
                                HorizontalAlignment="Center"
                                Fill="White"
                                Opacity="0.3" />
                        </StackPanel>

                        <!--  Item Flavor Text  -->
                        <Grid
                            Grid.Row="1"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Margin="0,45,0,0">

                            <ScrollViewer
                                Grid.Row="1"
                                Grid.ColumnSpan="1"
                                Margin="0,0,30,0"
                                HorizontalAlignment="Stretch"
                                Background="Transparent"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <ScrollViewer.Resources>
                                    <Style BasedOn="{StaticResource BorderedScrollBar}" TargetType="ScrollBar">
                                        <Setter Property="Width" Value="7" />
                                    </Style>
                                </ScrollViewer.Resources>
                                <StackPanel>
                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Panel.ZIndex="1"
                                        FontFamily="{DynamicResource Haas Grot Disp 75 Bold}"
                                        FontSize="22"
                                        Foreground="{StaticResource ForegroundColour90}"
                                        Opacity="0.9"
                                        Text="{Binding Item.ItemFlavorText, Converter={StaticResource StringToUpperConverter}}"
                                        TextWrapping="WrapWithOverflow"
                                        Typography.CapitalSpacing="True" />
                                    <TextBlock
                                        Margin="0,35,20,0"
                                        HorizontalAlignment="Left"
                                        d:Text="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum."
                                        FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                                        FontSize="23"
                                        LineHeight="32px"
                                        Text="{Binding Item.ItemLore}"
                                        TextWrapping="WrapWithOverflow"
                                        Typography.CapitalSpacing="True" />
                                </StackPanel>



                            </ScrollViewer>
                        </Grid>

                        <!--  Lower border  -->
                        <StackPanel
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="0,25,0,0"
                            VerticalAlignment="Center">

                            <Rectangle
                                Width="740"
                                Height="1"
                                HorizontalAlignment="Center"
                                Fill="White"
                                Opacity="0.3" />
                            <Rectangle
                                Width="34"
                                Height="3"
                                HorizontalAlignment="Center"
                                Fill="White"
                                Opacity="0.3" />

                        </StackPanel>
                    </Grid>

                </Grid>
            </Grid>

        </Viewbox>

        <Grid
            Grid.Row="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Background="#38000000"
            Visibility="Visible">
            <Viewbox HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel
                    Margin="0,10,75,10"
                    FlowDirection="RightToLeft"
                    Orientation="Horizontal">

                    <TextBlock
                        Margin="0,0,15,0"
                        VerticalAlignment="Center"
                        Panel.ZIndex="1"
                        d:FontFamily="Haas Grot Text 55 Roman, Destiny Keys"
                        FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                        FontSize="20"
                        Foreground="{StaticResource ForegroundColour80}"
                        Text=" Dismiss"
                        TextAlignment="Left"
                        TextWrapping="Wrap" />

                    <TextBlock
                        x:Name="HideMenuHint"
                        Margin="0,0,15,0"
                        VerticalAlignment="Center"
                        Panel.ZIndex="1"
                        d:FontFamily="Haas Grot Text 55 Roman, Destiny Keys"
                        FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                        FontSize="20"
                        Foreground="{StaticResource ForegroundColour80}"
                        Text=" Hide Menu"
                        TextAlignment="Left"
                        TextWrapping="Wrap" />

                    <TextBlock
                        x:Name="ShowLoreHint"
                        Margin="0,0,15,0"
                        VerticalAlignment="Center"
                        Panel.ZIndex="1"
                        d:FontFamily="Haas Grot Text 55 Roman, Destiny Keys"
                        FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                        FontSize="20"
                        Foreground="{StaticResource ForegroundColour80}"
                        Text=" Show Lore"
                        TextAlignment="Left"
                        TextWrapping="Wrap"
                        Visibility="Hidden" />

                </StackPanel>
            </Viewbox>
        </Grid>
    </Grid>

</UserControl>
