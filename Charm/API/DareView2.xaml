<UserControl
    x:Class="Charm.DareView2"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Charm"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="990"
    d:DesignWidth="1920"
    Focusable="True"
    KeyDown="UserControl_KeyDown"
    KeyboardNavigation.ControlTabNavigation="None"
    KeyboardNavigation.DirectionalNavigation="None"
    KeyboardNavigation.TabNavigation="None"
    Loaded="UserControl_Loaded"
    mc:Ignorable="d">

    <UserControl.Resources>
        <local:HolofoilShader
            x:Key="HolofoilShader"
            RenderOptions.BitmapScalingMode="LowQuality"
            RenderOptions.CachingHint="Cache" />

        <DataTemplate x:Key="ItemIconTemplate">
            <Grid ClipToBounds="True">
                <Image
                    Width="86"
                    Height="86"
                    Margin="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    RenderOptions.BitmapScalingMode="LowQuality"
                    Source="{Binding IconBackground}" />

                <Grid
                    Width="86"
                    Height="86"
                    IsHitTestVisible="False">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Item.IsHolofoil, Converter={StaticResource HolofoilEnabledConverter}}" Value="True" />
                                        <Condition Binding="{Binding Item.IsHolofoil}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <MultiDataTrigger.Setters>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger.Setters>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid>
                        <Grid.Effect>
                            <StaticResource ResourceKey="HolofoilShader" />
                        </Grid.Effect>
                    </Grid>

                    <Border
                        BorderBrush="White"
                        BorderThickness="8"
                        Opacity="0.15" />
                </Grid>

                <Grid
                    Width="86"
                    Height="86"
                    IsHitTestVisible="False">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Item.IsHolofoil, Converter={StaticResource HolofoilEnabledConverter}}" Value="False" />
                                        <Condition Binding="{Binding Item.IsHolofoil}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <MultiDataTrigger.Setters>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger.Setters>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <!--  Could be better but it works so good enough for me  -->
                    <Path
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Fill="#a2816f"
                        RenderTransformOrigin="1,0">
                        <Path.RenderTransform>
                            <RotateTransform Angle="-45" />
                        </Path.RenderTransform>
                        <Path.Data>
                            <GeometryGroup>
                                <RectangleGeometry Rect="15,0 86,3" />
                                <RectangleGeometry Rect="0,9 86,3" />
                                <RectangleGeometry Rect="0,18 86,3" />
                                <RectangleGeometry Rect="0,28 86,3" />
                            </GeometryGroup>
                        </Path.Data>
                    </Path>
                </Grid>


                <Image
                    Width="86"
                    Height="86"
                    Margin="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    RenderOptions.BitmapScalingMode="LowQuality"
                    Source="{Binding Icon}" />

                <Image
                    Width="86"
                    Height="86"
                    Margin="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    RenderOptions.BitmapScalingMode="LowQuality"
                    Source="{Binding IconOverlay}" />

                <Image
                    Width="16"
                    Height="16"
                    Margin="6"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    RenderOptions.BitmapScalingMode="LowQuality"
                    Source="{Binding IconOverlay2}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ItemIconWatermarkTemplate">
            <!--  Icon Watermark  -->
            <Grid
                Width="28"
                Height="48"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Panel.ZIndex="10"
                IsHitTestVisible="False"
                Visibility="{Binding ItemWatermark, Converter={StaticResource NullToVisibilityConverter}}">
                <Rectangle
                    Grid.Row="1"
                    Width="22"
                    Height="48"
                    Margin="0,3,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Opacity="0.6"
                    RenderOptions.EdgeMode="Aliased"
                    Stretch="Fill">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                            <GradientStop Offset="0" Color="#00000000" />
                            <GradientStop Offset="1" Color="Black" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!--  Featured item banner  -->
                <Polygon
                    Width="28"
                    Height="32"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Fill="#109191"
                    Points="0,0 0,32 14,28 28,32 28,0">
                    <Polygon.Style>
                        <Style TargetType="Polygon">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Hash, Converter={StaticResource Investment_IsFeaturedItem}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Polygon.Style>
                </Polygon>

                <Image
                    Width="20"
                    Height="20"
                    Margin="0,3,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Source="{Binding ItemWatermark}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CategoryHeader">
            <Grid Opacity="0.5">
                <Grid.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="Opacity"
                                    To="1"
                                    Duration="0:0:0.075" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>

                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="Opacity"
                                    To="0.5"
                                    Duration="0:0:0.075" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Grid.Triggers>

                <StackPanel Orientation="Vertical">
                    <StackPanel
                        Margin="0,0,0,5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Panel.ZIndex="1"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,5,0"
                            FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                            FontSize="22"
                            Foreground="White"
                            Text="{Binding CategoryName}" />

                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                            FontSize="18"
                            Foreground="White"
                            Text="{Binding CategoryAmount}"
                            Visibility="Collapsed" />
                    </StackPanel>

                    <Border
                        Margin="0,0,0,0"
                        BorderBrush="White"
                        BorderThickness="0,0,0,3"
                        Focusable="False" />
                </StackPanel>
            </Grid>

        </DataTemplate>

        <DataTemplate x:Key="DareSelectedEntry">
            <Grid Height="92" Background="Transparent">
                <Grid Loaded="DareSelectedEntry_Loaded" Visibility="{Binding IsPlaceholder, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <Rectangle
                        Grid.Row="0"
                        IsHitTestVisible="False"
                        Opacity="1">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                                <GradientStop Offset="0.75" Color="{Binding RarityColor}" />
                                <GradientStop Offset="0" Color="#00000000" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ContentControl
                            x:Name="IconHost"
                            Width="92"
                            Height="92"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{Binding}"
                            ContentTemplate="{StaticResource ItemIconTemplate}" />

                        <!--  Icon Watermark  -->
                        <Grid
                            Width="28"
                            Height="48"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Panel.ZIndex="10"
                            Visibility="{Binding ItemWatermark, Converter={StaticResource NullToVisibilityConverter}}">
                            <Rectangle
                                Grid.Row="1"
                                Width="22"
                                Height="48"
                                Margin="0,3,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Opacity="0.6"
                                RenderOptions.EdgeMode="Aliased"
                                Stretch="Fill">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                        <GradientStop Offset="0" Color="#00000000" />
                                        <GradientStop Offset="1" Color="Black" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <!--  Featured item banner  -->
                            <Polygon
                                Width="28"
                                Height="32"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Fill="#109191"
                                Points="0,0 0,32 14,28 28,32 28,0">
                                <Polygon.Style>
                                    <Style TargetType="Polygon">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Hash, Converter={StaticResource Investment_IsFeaturedItem}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Polygon.Style>
                            </Polygon>

                            <Image
                                Width="20"
                                Height="20"
                                Margin="0,3,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Source="{Binding ItemWatermark}" />
                        </Grid>

                        <Border
                            BorderThickness="3"
                            Focusable="False"
                            Opacity="1"
                            Style="{StaticResource GreyBorderWhiteOnHover}" />

                        <Button
                            Grid.ColumnSpan="2"
                            HorizontalAlignment="Stretch"
                            local:StyleHelper.BorderThickness="0.75"
                            Click="SelectedDareEntry_Click"
                            Focusable="False"
                            IsHitTestVisible="True"
                            MouseRightButtonDown="APIItem_View"
                            Style="{StaticResource D2StyleButtonNoOverlay}" />

                        <Grid
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                            <StackPanel Margin="10,0,25,0" Orientation="Vertical">
                                <Viewbox
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    StretchDirection="DownOnly">
                                    <TextBlock
                                        Margin="0,0,0,0"
                                        Panel.ZIndex="1"
                                        FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                                        FontSize="20"
                                        Foreground="White"
                                        Text="{Binding Item.Name}" />
                                </Viewbox>

                                <TextBlock
                                    Margin="0,5,0,5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Panel.ZIndex="1"
                                    FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                                    FontSize="16"
                                    Foreground="White"
                                    Opacity="0.75"
                                    Text="{Binding Item.Type}" />

                                <TextBlock
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Panel.ZIndex="1"
                                    FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                                    FontSize="12"
                                    Foreground="White"
                                    Opacity="0.5"
                                    Text="{Binding Item.ApiHash}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="DareEntry">
            <Grid Background="Transparent">
                <Grid Focusable="False" IsHitTestVisible="False">
                    <Border
                        Width="12"
                        Height="12"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="1,0,0,1"
                        Focusable="False" />

                    <Border
                        Width="12"
                        Height="12"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="1,1,0,0"
                        Focusable="False" />

                    <Border
                        Width="12"
                        Height="12"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="0,0,1,1"
                        Focusable="False" />

                    <Border
                        Width="12"
                        Height="12"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="0,1,1,0"
                        Focusable="False" />
                </Grid>

                <Grid Visibility="{Binding IsPlaceholder, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        d:FontFamily="Haas Grot Text 55 Roman"
                        FontFamily="{DynamicResource Haas Grot Text 65 Medium Keys}"
                        FontSize="64"
                        Text="?" />

                    <ContentControl
                        x:Name="IconHost"
                        Width="86"
                        Height="86"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="{Binding}"
                        ContentTemplate="{StaticResource ItemIconTemplate}" />

                    <Button
                        Width="86"
                        Height="86"
                        local:StyleHelper.BorderThickness="0.75"
                        Click="DareEntry_Click"
                        Focusable="False"
                        IsHitTestVisible="True"
                        MouseRightButtonDown="APIItem_View"
                        Style="{StaticResource D2StyleButton}" />

                    <Border
                        BorderThickness="3"
                        Focusable="False"
                        Style="{StaticResource GreyBorderWhiteOnHover}" />

                    <ContentControl
                        x:Name="IconWatermarkHost"
                        Width="86"
                        Height="86"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="{Binding}"
                        ContentTemplate="{StaticResource ItemIconWatermarkTemplate}" />

                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ItemCategory">
            <Grid
                Width="auto"
                Margin="0,0,0,0"
                HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ContentControl
                    Grid.Row="0"
                    Margin="40,5,40,5"
                    Content="{Binding}"
                    ContentTemplate="{StaticResource CategoryHeader}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Margin" Value="0,0,0,0" />

                        </Style>
                    </ContentControl.Style>
                </ContentControl>

                <Grid Grid.Row="1" VerticalAlignment="Top">
                    <local:ItemPage
                        x:Name="CategoryItems"
                        CollapsePageButtons="False"
                        Columns="12"
                        ItemMargin="5"
                        ItemTemplate="{StaticResource DareEntry}"
                        Items="{Binding Items}"
                        ItemsPerPage="{Binding ItemsPerPage}"
                        PageIndicatorMargin="0,0,0,-10"
                        SelectOnPageChange="False"
                        TransitionSpeed="0.075"
                        UsePlaceholders="True" />

                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Focusable="False" Style="{StaticResource GradientBackgroundSemiTransparent}">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Grid.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetProperty="Opacity"
                            From="0"
                            To="1"
                            Duration="0:0:0.25" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <Grid.RowDefinitions>
            <RowDefinition Height="5*" />
            <RowDefinition Height="90*" />
            <RowDefinition Height="5*" />
        </Grid.RowDefinitions>


        <Grid
            Grid.Row="0"
            Width="auto"
            VerticalAlignment="Stretch"
            Panel.ZIndex="1"
            Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="80*" />
                <RowDefinition Height="20*" />
            </Grid.RowDefinitions>

            <Rectangle Grid.Row="0" Opacity="0.8">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                        <GradientStop Offset="1" Color="#998129" />
                        <GradientStop Offset="-0.05" Color="#00000000" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Rectangle Grid.Row="1" Opacity="0.9">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                        <GradientStop Offset="1" Color="#cdad36" />
                        <GradientStop Offset="-0.05" Color="#00000000" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>


        <Grid
            Grid.RowSpan="3"
            Width="1920"
            Height="990"
            Panel.ZIndex="1"
            Background="Transparent"
            ClipToBounds="True"
            RenderTransformOrigin="0.5,0.5"
            SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="75*" />
                <ColumnDefinition Width="25*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="5*" />
                <RowDefinition Height="90*" />
                <RowDefinition Height="5*" />
            </Grid.RowDefinitions>

            <Border
                Grid.RowSpan="3"
                Grid.Column="1"
                Background="#CC1B1C20"
                BorderBrush="#62FFFFFF"
                BorderThickness="2,0,0,0"
                Opacity="1" />

            <Grid
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="1"
                Background="Transparent">

                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="5*" />
                    <RowDefinition Height="5*" />
                    <RowDefinition Height="90*" />
                </Grid.RowDefinitions>

                <StackPanel
                    x:Name="DareViewDevPanel"
                    Grid.Row="0"
                    Margin="15,5,15,0"
                    HorizontalAlignment="Left"
                    d:Visibility="Visible"
                    Background="Transparent"
                    Orientation="Horizontal"
                    Visibility="Hidden">
                    <Button Click="ExportAllShaders" Style="{DynamicResource D2StyleButton}">
                        <local:GenericTooltipProperties.TooltipData>
                            <local:GenericTooltip
                                Name="Export All Shaders"
                                Description="Export every shader to 'Output'/AllShaders, will take some time."
                                Style="Category" />
                        </local:GenericTooltipProperties.TooltipData>
                        <TextBlock
                            Margin="5,0,5,0"
                            d:FontFamily="Haas Grot Text 55 Roman"
                            FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                            FontSize="16"
                            Text="Export All Shaders" />
                    </Button>

                    <ToggleButton
                        Margin="10,0,0,0"
                        Click="LoadAllItems"
                        IsChecked="False"
                        Style="{DynamicResource D2StyleTagListButton}">
                        <local:GenericTooltipProperties.TooltipData>
                            <local:GenericTooltip
                                Name="Load All Items"
                                Description="Loads every InventoryItem definition."
                                Style="Category" />
                        </local:GenericTooltipProperties.TooltipData>
                        <TextBlock
                            Margin="5,0,5,0"
                            d:FontFamily="Haas Grot Text 55 Roman"
                            FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                            FontSize="16"
                            Text="Load All Items" />
                    </ToggleButton>
                </StackPanel>

                <Grid
                    Grid.Row="1"
                    Margin="15,0,15,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Background="Transparent">
                    <ToggleButton
                        x:Name="AggregateOutputButton"
                        HorizontalAlignment="Left"
                        Content="AGGREGATE OUTPUT"
                        FontSize="18"
                        Style="{DynamicResource D2StyleToggleBoxButton}">
                        <local:GenericTooltipProperties.TooltipData>
                            <local:GenericTooltip
                                Name="AGGREGATE OUTPUT"
                                Description="Exports selected items to a singular folder in your Charm output path.&#x0a;&#x0a;The folder will be named 'ApiOutput#', where the hashtag represents the current ApiOutput folder count"
                                Style="Category"
                                Type="Export Option" />
                        </local:GenericTooltipProperties.TooltipData>
                    </ToggleButton>

                    <Button
                        x:Name="Multi3DButton"
                        HorizontalAlignment="Right"
                        Click="Multi3DItemView"
                        Style="{DynamicResource D2StyleButton}"
                        Visibility="Collapsed">
                        <local:GenericTooltipProperties.TooltipData>
                            <local:GenericTooltip
                                Name="3D View"
                                Description="View everything in the export list in 3D."
                                Style="Category" />
                        </local:GenericTooltipProperties.TooltipData>
                        <TextBlock
                            Margin="5,0,5,0"
                            d:FontFamily="Haas Grot Text 55 Roman"
                            FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                            FontSize="16"
                            Text="View All In 3D" />
                    </Button>
                </Grid>

                <Grid
                    Grid.Row="2"
                    Margin="0,0,0,0"
                    Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30*" />
                        <ColumnDefinition Width="30*" />
                        <ColumnDefinition Width="30*" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="ExportButton"
                        Grid.Column="0"
                        Margin="15,0,15,0"
                        Click="ExportButton_Click"
                        Style="{DynamicResource D2StyleButton}">
                        <local:GenericTooltipProperties.TooltipData>
                            <local:GenericTooltip
                                Name="EXPORT"
                                Description="Exports everything in the export list"
                                Style="Category" />
                        </local:GenericTooltipProperties.TooltipData>
                        <TextBlock
                            d:FontFamily="Haas Grot Text 55 Roman"
                            FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                            FontSize="18"
                            Text="EXPORT" />
                    </Button>

                    <Button
                        x:Name="OpenOutputButton"
                        Grid.Column="1"
                        Margin="0,0,0,0"
                        Click="OpenOutputFolder_Click"
                        Style="{DynamicResource D2StyleButton}">
                        <local:GenericTooltipProperties.TooltipData>
                            <local:GenericTooltip
                                Name="OPEN OUTPUT"
                                Description="Opens the output folder for your rips"
                                Style="Category" />
                        </local:GenericTooltipProperties.TooltipData>
                        <TextBlock
                            d:FontFamily="Haas Grot Text 55 Roman"
                            FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                            FontSize="18"
                            Text="OPEN OUTPUT" />
                    </Button>

                    <Button
                        x:Name="ClearAllButton"
                        Grid.Column="2"
                        Margin="15,0,15,0"
                        Click="ClearAllButton_Click"
                        Style="{DynamicResource D2StyleButton}">
                        <local:GenericTooltipProperties.TooltipData>
                            <local:GenericTooltip
                                Name="CLEAR"
                                Description="Clears everything from the export list"
                                Style="Category" />
                        </local:GenericTooltipProperties.TooltipData>
                        <TextBlock
                            d:FontFamily="Haas Grot Text 55 Roman"
                            FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                            FontSize="18"
                            Text="CLEAR" />
                    </Button>
                </Grid>

                <local:ItemPage
                    x:Name="SelectedItemsList"
                    Grid.Row="3"
                    Margin="15,15,15,0"
                    CollapsePageButtons="False"
                    Columns="1"
                    IsVertical="True"
                    ItemMargin="3,0,3,0"
                    ItemTemplate="{StaticResource DareSelectedEntry}"
                    Items="{Binding SelectedItems}"
                    ItemsPerPage="7"
                    PageIndicatorMargin="0,0,0,-10"
                    ShowVerticalPageIndicator="True"
                    UsePlaceholders="True"
                    UseStackPanel="False" />
            </Grid>

            <Grid
                x:Name="MainGrid"
                Grid.Row="1"
                Grid.RowSpan="2"
                Grid.Column="0"
                Margin="25,0,0,0"
                ClipToBounds="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="90*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="10*" />
                    <RowDefinition Height="95*" />
                </Grid.RowDefinitions>

                <Button
                    x:Name="HelpButton"
                    Grid.Column="0"
                    Width="50"
                    Height="50"
                    HorizontalAlignment="Right"
                    local:StyleHelper.CornerRadius="100"
                    Click="HelpButton_Click"
                    Style="{DynamicResource D2StyleButton}">
                    <TextBlock
                        d:FontFamily="Haas Grot Text 55 Roman"
                        FontFamily="{DynamicResource Haas Grot Text 65 Medium Keys}"
                        FontSize="32"
                        Text="?" />
                </Button>

                <Grid
                    Name="HolofoilShaderPreload"
                    Width="1"
                    Height="1"
                    Opacity="0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding {x:Null}, Converter={StaticResource HolofoilEnabledConverter}}" Value="True">
                                    <Setter Property="Visibility" Value="Hidden" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid CacheMode="BitmapCache">
                        <Grid.Effect>
                            <StaticResource ResourceKey="HolofoilShader" />
                        </Grid.Effect>
                    </Grid>

                    <Border
                        BorderBrush="White"
                        BorderThickness="8"
                        Opacity="0.15" />
                </Grid>

                <Grid Grid.Row="0" Grid.Column="1">
                    <StackPanel
                        x:Name="FilterOptions"
                        Grid.Row="0"
                        Margin="0,0,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBox
                            x:Name="SearchBox"
                            Grid.Row="0"
                            Width="350"
                            Margin="10,0,10,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            FontSize="30"
                            TextChanged="SearchBox_TextChanged"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid
                        x:Name="RenegadesDisclaimer"
                        Margin="0,-20,50,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="#755C0000"
                        Visibility="Collapsed">
                        <Button
                            Grid.Column="0"
                            Panel.ZIndex="100"
                            Style="{DynamicResource D2StyleButton}">
                            <local:GenericTooltipProperties.TooltipData>
                                <local:GenericTooltip
                                    Name="DISCLAIMER"
                                    BodyColor="#100000"
                                    Description=" Any Star Wars themed gear CAN NOT be uploaded to the Destiny Model Rips Discord or Google Drive due to potential copyright claims by Disney...&#x0a;&#x0a; Many item strings may appear as 'Redacted-###' if you do not have the correct decryption key, due to those strings being in redacted pkg files."
                                    HeaderColor="#5C0000"
                                    Style="Category" />
                            </local:GenericTooltipProperties.TooltipData>
                            <TextBlock
                                d:FontFamily="Haas Grot Text 55 Roman"
                                FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                                FontSize="14"
                                Text="RENEGADES DISCLAIMER" />
                        </Button>
                    </Grid>
                </Grid>

                <local:ItemPage
                    x:Name="Categories"
                    Grid.Row="1"
                    Grid.Column="1"
                    VerticalAlignment="Stretch"
                    Columns="1"
                    HidePageButtons="True"
                    IsVertical="True"
                    ItemMargin="0,0,0,25"
                    ItemTemplate="{StaticResource ItemCategory}"
                    Items="{Binding ItemCategories}"
                    ItemsPerPage="3"
                    PageIndicatorMargin="0,0,0,25"
                    SelectOnPageChange="False"
                    ShowVerticalPageIndicator="True"
                    SlideDistance="5"
                    TransitionSpeed="0.075"
                    UsePlaceholders="False"
                    UseStackPanel="False" />

                <Grid
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,50,0,50"
                    HorizontalAlignment="Right">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50*" />
                        <RowDefinition Height="50*" />
                    </Grid.RowDefinitions>

                    <Button
                        x:Name="PreviousPage"
                        Width="50"
                        Height="Auto"
                        Margin="2,0,0,0"
                        local:StyleHelper.BorderThickness="1"
                        Focusable="False"
                        Visibility="Visible">
                        <Button.Style>
                            <Style BasedOn="{StaticResource D2StyleButtonNoOverlay}" TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVertical}" Value="False">
                                        <Setter Property="Width" Value="Auto" />
                                        <Setter Property="Height" Value="35" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Border Background="#33FFFFFF" Focusable="False">
                            <Polygon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Fill="#CCFFFFFF"
                                Points="0, 0 60, 50, 0, 100">
                                <Polygon.Style>
                                    <Style TargetType="Polygon">
                                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                        <Setter Property="LayoutTransform">
                                            <Setter.Value>
                                                <TransformGroup>
                                                    <ScaleTransform ScaleX="0.15" ScaleY="0.15" />
                                                    <RotateTransform Angle="-90" />
                                                </TransformGroup>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsVertical}" Value="True">
                                                <Setter Property="LayoutTransform">
                                                    <Setter.Value>
                                                        <TransformGroup>
                                                            <ScaleTransform ScaleX="0.15" ScaleY="0.15" />
                                                            <RotateTransform Angle="00" />
                                                        </TransformGroup>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Polygon.Style>
                            </Polygon>
                        </Border>
                    </Button>

                    <Button
                        x:Name="NextPage"
                        Grid.Row="1"
                        Width="50"
                        Height="Auto"
                        Margin="2,0,0,0"
                        local:StyleHelper.BorderThickness="1"
                        Focusable="False"
                        Visibility="Visible">
                        <Button.Style>
                            <Style BasedOn="{StaticResource D2StyleButtonNoOverlay}" TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVertical}" Value="False">
                                        <Setter Property="Width" Value="Auto" />
                                        <Setter Property="Height" Value="35" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Border Background="#33FFFFFF" Focusable="False">
                            <Polygon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Fill="#CCFFFFFF"
                                Points="0, 0 60, 50, 0, 100">
                                <Polygon.Style>
                                    <Style TargetType="Polygon">
                                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                        <Setter Property="LayoutTransform">
                                            <Setter.Value>
                                                <TransformGroup>
                                                    <ScaleTransform ScaleX="0.15" ScaleY="0.15" />
                                                    <RotateTransform Angle="90" />
                                                </TransformGroup>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsVertical}" Value="True">
                                                <Setter Property="LayoutTransform">
                                                    <Setter.Value>
                                                        <TransformGroup>
                                                            <ScaleTransform ScaleX="0.15" ScaleY="0.15" />
                                                            <RotateTransform Angle="00" />
                                                        </TransformGroup>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Polygon.Style>
                            </Polygon>
                        </Border>
                    </Button>
                </Grid>
            </Grid>
        </Grid>

    </Grid>
</UserControl>
