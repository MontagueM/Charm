<UserControl
    x:Class="Charm.Collections.QuestView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Charm"
    xmlns:localCollections="clr-namespace:Charm.Collections"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="984"
    d:DesignWidth="1914"
    Focusable="True"
    Loaded="UserControl_Loaded"
    PreviewKeyDown="UserControl_PreviewKeyDown"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="QuestStepEntry">
            <StackPanel Width="980" Orientation="Vertical">
                <Grid>
                    <Grid
                        x:Name="ClipContainer"
                        Width="{Binding ActualWidth, ElementName=ClipRect}"
                        Height="{Binding ActualHeight, ElementName=ClipRect}"
                        ClipToBounds="True">
                        <Rectangle
                            x:Name="ClipRect"
                            Height="487"
                            Panel.ZIndex="0"
                            Opacity="0.05">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="White" />
                                    <GradientStop Offset="1" Color="#00000000" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <Image
                            Width="440"
                            Height="440"
                            Margin="0,-40,-25,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Opacity="0.02"
                            RenderOptions.CachingHint="Cache"
                            Source="{Binding DataContext.QuestTypeIconContainer, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type localCollections:QuestView}}, Converter={StaticResource TextureFromIconContainerConverter}, ConverterParameter=0|4}" />
                    </Grid>

                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50*" />
                            <ColumnDefinition Width="50*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="70*" />
                            <RowDefinition Height="35*" />
                        </Grid.RowDefinitions>

                        <ScrollViewer
                            Grid.Row="0"
                            MaxHeight="250"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Resources>
                                <Style BasedOn="{StaticResource VerticalScrollBarStyle}" TargetType="ScrollBar">
                                    <Setter Property="Width" Value="5" />
                                </Style>
                            </ScrollViewer.Resources>
                            <TextBlock
                                FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                                FontSize="22"
                                Foreground="{StaticResource ForegroundColour90}"
                                Opacity="0.9"
                                Text="{Binding QuestStepDescription}"
                                TextAlignment="Left"
                                TextWrapping="Wrap" />
                        </ScrollViewer>

                        <ItemsControl
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            ItemTemplateSelector="{StaticResource ObjBlockTemplateSelector}"
                            ItemsSource="{Binding QuestObjectives}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel
                                        Grid.Row="0"
                                        Width="auto"
                                        Height="auto"
                                        Margin="0,0,0,0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Top"
                                        Background="Transparent"
                                        Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Margin" Value="0,3,-10,3" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>


                        <StackPanel
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Margin="0,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Orientation="Vertical"
                            Visibility="{Binding QuestStepFlavorText, Converter={StaticResource StringNullOrEmptyVisibilityConverter}}">

                            <Rectangle
                                Grid.Row="0"
                                Width="936"
                                Height="2"
                                Margin="0,0,0,15"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Fill="White"
                                Opacity="0.25" />

                            <TextBlock
                                Panel.ZIndex="1"
                                FontFamily="{DynamicResource Haas Grot Text 56 Italic}"
                                FontSize="22"
                                Foreground="{StaticResource ForegroundColour90}"
                                Opacity="0.6"
                                Text="{Binding QuestStepFlavorText}"
                                TextWrapping="WrapWithOverflow" />
                        </StackPanel>

                    </Grid>
                </Grid>

                <Grid>
                    <Rectangle
                        Grid.Row="0"
                        Width="8"
                        Height="4"
                        Margin="0,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Fill="White"
                        Opacity="0.25" />

                    <Rectangle
                        Grid.Row="0"
                        Width="8"
                        Height="4"
                        Margin="0,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Fill="White"
                        Opacity="0.25" />
                </Grid>

            </StackPanel>


        </DataTemplate>

        <local:HolofoilShader
            x:Key="HolofoilShader"
            RenderOptions.BitmapScalingMode="LowQuality"
            RenderOptions.CachingHint="Cache" />

        <DataTemplate x:Key="ItemIconTemplate">
            <Grid>
                <Image
                    Width="96"
                    Height="96"
                    Margin="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Source="{Binding IconBackground}" />

                <Grid
                    Width="96"
                    Height="96"
                    IsHitTestVisible="False">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Item.IsHolofoil, Converter={StaticResource HolofoilEnabledConverter}}" Value="True" />
                                        <Condition Binding="{Binding Item.IsHolofoil}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <MultiDataTrigger.Setters>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger.Setters>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid>
                        <Grid.Effect>
                            <StaticResource ResourceKey="HolofoilShader" />
                        </Grid.Effect>
                    </Grid>

                    <Border
                        BorderBrush="White"
                        BorderThickness="8"
                        Opacity="0.15" />
                </Grid>

                <Image
                    Width="96"
                    Height="96"
                    Margin="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Source="{Binding Icon}" />

                <Image
                    Width="96"
                    Height="96"
                    Margin="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Source="{Binding IconOverlay}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ItemIconWatermarkTemplate">
            <!--  Icon Watermark  -->
            <Grid
                Width="28"
                Height="48"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Panel.ZIndex="10"
                IsHitTestVisible="False"
                Visibility="{Binding ItemWatermark, Converter={StaticResource NullToVisibilityConverter}}">
                <Rectangle
                    Grid.Row="1"
                    Width="22"
                    Height="48"
                    Margin="0,3,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Opacity="0.6"
                    RenderOptions.EdgeMode="Aliased"
                    Stretch="Fill">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                            <GradientStop Offset="0" Color="#00000000" />
                            <GradientStop Offset="1" Color="Black" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!--  Featured item banner  -->
                <Polygon
                    Width="28"
                    Height="32"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Fill="#109191"
                    Points="0,0 0,32 14,28 28,32 28,0">
                    <Polygon.Style>
                        <Style TargetType="Polygon">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Hash, Converter={StaticResource Investment_IsFeaturedItem}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Polygon.Style>
                </Polygon>

                <Image
                    Width="20"
                    Height="20"
                    Margin="0,3,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Source="{Binding ItemWatermark}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="RewardEntry">
            <Grid Background="Transparent">
                <Grid Focusable="False" IsHitTestVisible="False">
                    <Border
                        Width="12"
                        Height="12"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="1,0,0,1"
                        Focusable="False" />

                    <Border
                        Width="12"
                        Height="12"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="1,1,0,0"
                        Focusable="False" />

                    <Border
                        Width="12"
                        Height="12"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="0,0,1,1"
                        Focusable="False" />

                    <Border
                        Width="12"
                        Height="12"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="0,1,1,0"
                        Focusable="False" />
                </Grid>

                <Grid Visibility="{Binding IsPlaceholder, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <ContentControl
                        x:Name="IconHost"
                        Width="96"
                        Height="96"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="{Binding Item}"
                        ContentTemplate="{StaticResource ItemIconTemplate}" />

                    <Button
                        Width="96"
                        Height="96"
                        local:StyleHelper.BorderThickness="0.75"
                        DataContext="{Binding Item}"
                        Focusable="False"
                        IsHitTestVisible="True"
                        Style="{StaticResource D2StyleButton}" />

                    <Border
                        BorderThickness="2"
                        Focusable="False"
                        Style="{StaticResource GreyBorderWhiteOnHover}">
                        <Border
                            Height="25"
                            MinWidth="25"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="{StaticResource ForegroundColour80}"
                            IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Quantity}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Quantity}" Value="1">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <TextBlock
                                Margin="0,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                                FontSize="20"
                                Foreground="Black"
                                Opacity="1"
                                Text="{Binding Quantity}"
                                TextAlignment="Left"
                                TextWrapping="Wrap" />
                        </Border>
                    </Border>

                    <ContentControl
                        x:Name="IconWatermarkHost"
                        Width="96"
                        Height="96"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="{Binding Item}"
                        ContentTemplate="{StaticResource ItemIconWatermarkTemplate}" />

                </Grid>
            </Grid>
        </DataTemplate>

        <Style x:Key="CollapseOnLoad" TargetType="Rectangle">
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetProperty="Width"
                                To="0"
                                Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>


    <Grid x:Name="MainGrid">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Grid.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetProperty="Opacity"
                            From="0"
                            To="1"
                            Duration="0:0:0.25" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0,0" Opacity="0.4" RadiusX="2" RadiusY="2">
                <RadialGradientBrush.GradientStops>
                    <GradientStop Offset="0" Color="{Binding GradientColor}" />
                    <GradientStop Offset="0.5" Color="#00000000" />
                </RadialGradientBrush.GradientStops>
            </RadialGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="30*" />
            <RowDefinition Height="70*" />
        </Grid.RowDefinitions>

        <Border
            Grid.RowSpan="2"
            Margin="10,10,10,50"
            BorderBrush="White"
            BorderThickness="2,2,2,0"
            Opacity="0.2" />

        <Grid Name="QuestLineHeader" Margin="0">
            <Image
                x:Name="QuestHeaderIcon"
                Width="256"
                Height="256"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                d:Source="https://www.bungie.net/common/destiny2_content/icons/df47efeef7e689ee8b59f6deaa8aebce.png"
                Source="{Binding QuestIcon}" />

            <Grid
                Margin="0,0,0,20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Rectangle
                    Grid.Row="0"
                    Width="48"
                    Height="6"
                    Margin="0,-20,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Fill="White"
                    Opacity="0.25" />

                <Rectangle
                    Grid.Row="0"
                    Width="48"
                    Height="6"
                    Margin="0,-20,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Fill="White"
                    Opacity="0.25" />

                <Grid
                    Grid.Row="1"
                    Height="75"
                    MinWidth="810"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*" />
                        <ColumnDefinition Width="50*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.ColumnSpan="2"
                        Background="#3A000000"
                        BorderBrush="#40FFFFFF"
                        BorderThickness="1">
                        <TextBlock
                            Name="QuestLineName"
                            Margin="50,0,50,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            d:FontFamily="Haas Grot Disp 75 Bold"
                            d:Text="ASSET PROTECTION"
                            FontFamily="{DynamicResource Haas Grot Disp 75 Bold}"
                            FontSize="60"
                            Foreground="White"
                            Text="{Binding QuestName}"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Typography.CapitalSpacing="True">
                            <TextBlock.Effect>
                                <DropShadowEffect
                                    BlurRadius="2"
                                    Direction="-90"
                                    Opacity="1"
                                    ShadowDepth="2"
                                    Color="#1B1B1B" />
                            </TextBlock.Effect>
                        </TextBlock>
                    </Border>

                    <Rectangle
                        Grid.Column="0"
                        Width="{Binding ColumnDefinitions[0].ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                        HorizontalAlignment="Left"
                        Panel.ZIndex="1"
                        d:Visibility="Hidden"
                        Fill="White"
                        Style="{StaticResource CollapseOnLoad}" />

                    <Rectangle
                        Grid.Column="1"
                        Width="{Binding ColumnDefinitions[1].ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                        HorizontalAlignment="Right"
                        Panel.ZIndex="1"
                        d:Visibility="Hidden"
                        Fill="White"
                        Style="{StaticResource CollapseOnLoad}" />
                </Grid>


                <Grid
                    Margin="0,0,0,-50"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Opacity="0.65">
                    <StackPanel Orientation="Horizontal">
                        <Image
                            Width="38"
                            Height="38"
                            d:Source="https://www.bungie.net/common/destiny2_content/icons/2ffa90c58bdadcca8226f553315212e7.png"
                            Source="{Binding QuestTypeIconContainer, Converter={StaticResource TextureFromIconContainerConverter}, ConverterParameter=0|0}" />

                        <TextBlock
                            Name="QuestType"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            d:FontFamily="Haas Grot Text 55 Roman"
                            d:Text="Exotic Quest"
                            FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                            FontSize="20"
                            Foreground="White"
                            Text="{Binding QuestType}"
                            TextAlignment="Left"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <Grid Name="QuestInfo" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="35*" />
                <ColumnDefinition Width="65*" />
            </Grid.ColumnDefinitions>

            <Grid
                Name="QuestStepSummary"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="Transparent">

                <StackPanel Width="554" Orientation="Vertical">
                    <TextBlock
                        Margin="0,0,0,5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        d:FontFamily="Haas Grot Text 65 Medium"
                        FontFamily="{DynamicResource Haas Grot Text 65 Medium}"
                        FontSize="16"
                        Foreground="#8CFFFFFF"
                        Text="Q  U  E  S  T     I  N  F  O"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />


                    <Grid>
                        <Rectangle
                            Height="487"
                            Panel.ZIndex="0"
                            Opacity="0.05">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="White" />
                                    <GradientStop Offset="1" Color="#00000000" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <StackPanel Margin="20" Orientation="Vertical">

                            <Image
                                Width="510"
                                Height="150"
                                Margin="0,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                d:Source="https://www.bungie.net/common/destiny2_content/icons/72c63c315739705eb5347c4325b76f0e.jpg"
                                Opacity="1"
                                RenderOptions.CachingHint="Cache"
                                Source="{Binding CurrentStep.QuestStepBanner}" />

                            <ScrollViewer
                                Grid.Row="1"
                                Height="125"
                                Margin="0,10,0,10"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <ScrollViewer.Resources>
                                    <Style BasedOn="{StaticResource VerticalScrollBarStyle}" TargetType="ScrollBar">
                                        <Setter Property="Width" Value="5" />
                                    </Style>
                                </ScrollViewer.Resources>

                                <TextBlock
                                    Name="QuestStepSummaryText"
                                    Margin="0,0,5,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    d:FontFamily="Haas Grot Text 55 Roman"
                                    d:Foreground="#E6E6E6"
                                    d:Text="Ada-1 requests that you run a simulation of the foiled Fallen heist in the Old Tower so that she can gather data to recreate an infamous weapon of the past."
                                    FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                                    FontSize="22"
                                    Foreground="{StaticResource ForegroundColour90}"
                                    Opacity="0.6"
                                    Text="{Binding CurrentStep.QuestStepSummary}"
                                    TextAlignment="Left"
                                    TextWrapping="Wrap" />
                            </ScrollViewer>


                            <StackPanel Orientation="Vertical" Visibility="{Binding CurrentStep.QuestRewards, Converter={StaticResource IsCollectionEmptyToVisConverter}}">
                                <TextBlock
                                    Margin="0,0,0,5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    d:FontFamily="Haas Grot Text 65 Medium"
                                    FontFamily="{DynamicResource Haas Grot Text 65 Medium}"
                                    FontSize="16"
                                    Foreground="#5ca369"
                                    Opacity="0.9"
                                    Text="Q   U   E   S   T      R   E   W   A   R   D"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />

                                <Rectangle
                                    Grid.Row="0"
                                    Width="510"
                                    Height="2"
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Fill="#5ca369"
                                    Opacity="0.2" />

                                <ScrollViewer
                                    Grid.Row="1"
                                    Margin="0,0,0,0"
                                    CanContentScroll="True"
                                    HorizontalScrollBarVisibility="Auto"
                                    VerticalScrollBarVisibility="Auto">
                                    <ScrollViewer.Resources>
                                        <Style BasedOn="{StaticResource HorizontalScrollBarStyle}" TargetType="ScrollBar">
                                            <Setter Property="Height" Value="7" />
                                        </Style>
                                    </ScrollViewer.Resources>

                                    <ItemsControl
                                        Grid.Column="1"
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        ItemTemplate="{StaticResource RewardEntry}"
                                        ItemsSource="{Binding CurrentStep.QuestRewards}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel
                                                    Grid.Row="0"
                                                    Margin="0,0,0,0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Background="Transparent"
                                                    Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Margin" Value="5" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>


                        </StackPanel>
                    </Grid>


                    <Grid>
                        <Rectangle
                            Grid.Row="0"
                            Width="8"
                            Height="4"
                            Margin="0,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Fill="White"
                            Opacity="0.25" />

                        <Rectangle
                            Grid.Row="0"
                            Width="8"
                            Height="4"
                            Margin="0,0,0,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Fill="White"
                            Opacity="0.25" />
                    </Grid>


                </StackPanel>
            </Grid>

            <Grid
                Name="QuestStepsPanel"
                Grid.Column="1"
                Margin="50,0,50,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="Transparent">

                <StackPanel Orientation="Vertical">
                    <TextBlock
                        Margin="0,0,0,5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        d:FontFamily="Haas Grot Text 65 Medium"
                        FontFamily="{DynamicResource Haas Grot Text 65 Medium}"
                        FontSize="16"
                        Foreground="#8CFFFFFF"
                        TextAlignment="Left"
                        TextWrapping="Wrap">
                        <Run Text="Q  U  E  S  T     S  T  E  P     " />
                        <Run Foreground="White" Text="{Binding CurrentPage, ElementName=QuestSteps, Converter={StaticResource AddOneConverter}}" />
                        <Run Text="     O  F     " />
                        <Run Foreground="White" Text="{Binding TotalPages, ElementName=QuestSteps}" />
                    </TextBlock>

                    <local:ItemPage
                        x:Name="QuestSteps"
                        CollapsePageButtons="False"
                        Columns="1"
                        ItemMargin="10,0,10,0"
                        ItemTemplate="{StaticResource QuestStepEntry}"
                        Items="{Binding QuestSteps}"
                        ItemsPerPage="1"
                        UsePlaceholders="False" />
                </StackPanel>
            </Grid>
        </Grid>


        <Grid
            Grid.Row="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Background="#38000000"
            Visibility="Visible">
            <StackPanel
                Margin="0,10,75,10"
                FlowDirection="RightToLeft"
                Orientation="Horizontal">

                <TextBlock
                    Margin="0,0,15,0"
                    VerticalAlignment="Center"
                    Panel.ZIndex="1"
                    d:FontFamily="Haas Grot Text 55 Roman, Destiny Keys"
                    FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                    FontSize="22"
                    Foreground="{StaticResource ForegroundColour80}"
                    Text=" Dismiss"
                    TextAlignment="Left"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>

</UserControl>
