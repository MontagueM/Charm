<UserControl
    x:Class="Charm.Collections.QuestListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Charm"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="984"
    d:DesignWidth="1914"
    Focusable="True"
    Loaded="UserControl_Loaded"
    PreviewKeyDown="UserControl_PreviewKeyDown"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="CategoryButton">
            <RadioButton
                Width="70"
                Height="70"
                local:StyleHelper.BorderThickness="0.75"
                Checked="CategoryButton_Click"
                Focusable="False"
                GroupName="Categories"
                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                IsHitTestVisible="True"
                Style="{StaticResource D2StyleRadioButton}">
                <Border
                    BorderThickness="0.75"
                    Focusable="False"
                    Style="{StaticResource GreyBorderWhiteOnHover}">
                    <Image Margin="0" Source="{Binding CategoryIcon}">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Opacity" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="False">
                                        <Setter Property="Opacity" Value="0.4" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                </Border>
            </RadioButton>
        </DataTemplate>

        <DataTemplate x:Key="QuestItemTemplate">
            <Grid
                Width="460"
                Height="136"
                Background="Transparent">
                <Grid Background="#0FFFFFFF" Visibility="{Binding IsPlaceholder, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <Button
                        Margin="0,0,0,0"
                        local:StyleHelper.BorderThickness="0.5"
                        Focusable="False"
                        MouseEnter="QuestItem_MouseEnter"
                        MouseRightButtonDown="QuestItem_MouseRightButtonDown"
                        Style="{DynamicResource D2StyleButton}">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="75*" />
                            </Grid.ColumnDefinitions>

                            <Rectangle
                                Grid.Row="0"
                                Grid.ColumnSpan="2"
                                VerticalAlignment="Stretch"
                                Stretch="Fill"
                                Visibility="{Binding MainTrait, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=item_quest_exotic}">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="#00000000" />
                                        <GradientStop Offset="1" Color="#4dcdad36" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <Border
                                Width="96"
                                Height="96"
                                Margin="10,10,10,10"
                                VerticalAlignment="Top"
                                Background="#40000000"
                                BorderBrush="#40FFFFFF"
                                BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding QuestIcon}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Image
                                    Grid.Column="0"
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Source="{Binding QuestIcon}" />
                            </Border>


                            <Grid
                                Grid.Column="1"
                                Margin="0,10,10,0"
                                VerticalAlignment="Top"
                                Background="Transparent">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="50*" />
                                    <RowDefinition Height="50*" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Left"
                                    FontFamily="{DynamicResource Haas Grot Text 65 Medium Keys}"
                                    FontSize="22"
                                    Foreground="White"
                                    Opacity="0.8"
                                    Text="{Binding QuestName}"
                                    TextTrimming="WordEllipsis"
                                    TextWrapping="NoWrap" />

                                <TextBlock
                                    Grid.Row="1"
                                    Margin="0,5,0,0"
                                    HorizontalAlignment="Left"
                                    FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                                    FontSize="20"
                                    Foreground="White"
                                    Opacity="0.65"
                                    Text="{Binding QuestDescription}"
                                    TextTrimming="WordEllipsis"
                                    TextWrapping="WrapWithOverflow" />
                            </Grid>
                        </Grid>
                    </Button>
                </Grid>

                <!--  Placeholder Rectangle  -->
                <Rectangle Panel.ZIndex="-1" Fill="#10b7b7b7" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="MainGrid" Focusable="False">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Grid.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetProperty="Opacity"
                            From="0"
                            To="1"
                            Duration="0:0:0.25" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <Grid.RowDefinitions>
            <RowDefinition Height="5*" />
            <RowDefinition Height="95*" />
        </Grid.RowDefinitions>

        <Image
            Grid.Row="0"
            Grid.RowSpan="3"
            Width="1920"
            Height="1080"
            VerticalAlignment="Bottom"
            Panel.ZIndex="0"
            Source="C:/Users/Michael/Desktop/a.png"
            Stretch="Fill"
            Visibility="Collapsed" />

        <Grid x:Name="CategoryGradient" Grid.RowSpan="2">
            <Grid.Background>
                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="1,0" Opacity="0.4" RadiusX="2" RadiusY="2">
                    <RadialGradientBrush.GradientStops>
                        <GradientStop Offset="0" Color="{Binding CurrentCategory.GradientColor}" />
                        <GradientStop Offset="0.5" Color="#00000000" />
                    </RadialGradientBrush.GradientStops>
                </RadialGradientBrush>
            </Grid.Background>
        </Grid>

        <Grid
            x:Name="CategoryRibbon"
            Grid.Row="0"
            Width="auto"
            Margin="0,0,0,0"
            VerticalAlignment="Stretch"
            Panel.ZIndex="1"
            Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="80*" />
                <RowDefinition Height="20*" />
            </Grid.RowDefinitions>

            <Rectangle
                Grid.Row="0"
                Grid.RowSpan="1"
                Fill="{Binding CurrentCategory.GradientColor, Converter={StaticResource ColorToBrush}}"
                Opacity="0.651" />
            <Rectangle
                Grid.Row="1"
                Fill="{Binding CurrentCategory.GradientColor, Converter={StaticResource ColorToBrush}}"
                Opacity="0.902" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="10*" />
                <RowDefinition Height="90*" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10*" />
                <ColumnDefinition Width="83*" />
            </Grid.ColumnDefinitions>

            <ItemsControl
                x:Name="CategoriesPanel"
                Grid.Row="1"
                Grid.Column="0"
                Margin="0,0,15,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                ItemTemplate="{StaticResource CategoryButton}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel
                            Grid.Row="0"
                            Margin="0,0,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="2.5" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>

            <Grid
                x:Name="QuestsPanel"
                Grid.Row="1"
                Grid.Column="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52*" />
                    <ColumnDefinition Width="25*" />
                    <ColumnDefinition Width="5*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="65,-35,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                    FontSize="22"
                    Foreground="White"
                    Opacity="1"
                    Text="{Binding CurrentCategory.CategoryName, Converter={StaticResource StringToUpperConverter}}" />

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,-35,90,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                    FontSize="20"
                    Foreground="White"
                    Opacity="0.65"
                    Text="{Binding CurrentCategory.Quests, Converter={StaticResource ListCountConverter}}" />

                <local:ItemPage
                    x:Name="QuestsList"
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="25,0,25,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    CollapsePageButtons="False"
                    Columns="2"
                    ItemMargin="5"
                    ItemTemplate="{StaticResource QuestItemTemplate}"
                    ItemsPerPage="10"
                    TransitionSpeed="0.125"
                    UsePlaceholders="True" />


                <Grid
                    Grid.Row="0"
                    Grid.Column="1"
                    Width="452"
                    Margin="50,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch">
                    <Rectangle
                        Grid.Row="0"
                        Grid.Column="1"
                        Width="18"
                        Height="4"
                        Margin="0,-15,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Fill="White"
                        Opacity="0.25" />

                    <StackPanel Orientation="Vertical">
                        <Image
                            Height="279"
                            Margin="0,0,0,25"
                            VerticalAlignment="Top"
                            Source="{Binding CurrentCategory.CategoryBanner}">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentCategory.CategoryBanner}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>

                        <TextBlock
                            Grid.Row="0"
                            Margin="0,0,0,10"
                            HorizontalAlignment="Left"
                            FontFamily="{DynamicResource Haas Grot Text 65 Medium Keys}"
                            FontSize="36"
                            Foreground="White"
                            Opacity="1"
                            Text="{Binding CurrentCategory.CategoryLabel, Converter={StaticResource StringToUpperConverter}}"
                            Typography.CapitalSpacing="True" />

                        <TextBlock
                            Grid.Row="0"
                            Margin="0,2,0,0"
                            HorizontalAlignment="Left"
                            FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                            FontSize="22"
                            Foreground="White"
                            Opacity="0.65"
                            Text="{Binding CurrentCategory.CategoryDescription}"
                            TextWrapping="WrapWithOverflow" />
                    </StackPanel>

                    <Border
                        Grid.Row="0"
                        Grid.Column="1"
                        Width="18"
                        Height="18"
                        Margin="0,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        BorderBrush="White"
                        BorderThickness="1,0,0,1"
                        Opacity="0.25" />

                    <Border
                        Grid.Row="0"
                        Grid.Column="1"
                        Width="18"
                        Height="18"
                        Margin="0,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        BorderBrush="White"
                        BorderThickness="0,0,1,1"
                        Opacity="0.25" />

                </Grid>
            </Grid>
        </Grid>

        <Grid
            Grid.Row="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Background="#38000000"
            Visibility="Visible">
            <StackPanel
                Margin="0,10,75,10"
                FlowDirection="RightToLeft"
                Orientation="Horizontal">

                <TextBlock
                    Margin="0,0,15,0"
                    VerticalAlignment="Center"
                    Panel.ZIndex="1"
                    d:FontFamily="Haas Grot Text 55 Roman, Destiny Keys"
                    FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                    FontSize="22"
                    Foreground="{StaticResource ForegroundColour80}"
                    Text=" Dismiss"
                    TextAlignment="Left"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
