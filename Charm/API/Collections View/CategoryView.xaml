<UserControl
    x:Class="Charm.CategoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Charm"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="984"
    d:DesignWidth="1914"
    Focusable="True"
    KeyboardNavigation.ControlTabNavigation="None"
    KeyboardNavigation.DirectionalNavigation="None"
    KeyboardNavigation.TabNavigation="None"
    Loaded="OnControlLoaded"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="CategoryItemTemplate">
            <RadioButton
                Margin="0,0,0,0"
                local:StyleHelper.BorderThickness="0.75"
                Checked="Category_OnSelect"
                Focusable="False"
                GroupName="Categories"
                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                MouseEnter="CategoryButton_MouseEnter"
                MouseLeave="PlugItem_MouseLeave"
                Style="{DynamicResource D2StyleRadioButton}">
                <Border Margin="5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <!--  Trigger when IsSelected (IsChecked) is false  -->
                                <DataTrigger Binding="{Binding IsSelected}" Value="False">
                                    <Setter Property="Opacity" Value="0.3" />
                                </DataTrigger>
                                <!--  Trigger when IsSelected (IsChecked) is true  -->
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Opacity" Value="1.0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Image
                        MaxWidth="84"
                        MaxHeight="84"
                        Source="{Binding ItemCategoryIcon}" />
                </Border>
            </RadioButton>
        </DataTemplate>

        <DataTemplate x:Key="SubcategoryItemTemplate">
            <Grid Background="Transparent">
                <RadioButton
                    x:Name="SubcategoryButton"
                    Margin="0,0,0,0"
                    Checked="Subcategory_OnSelect"
                    Focusable="False"
                    GroupName="Subcategories"
                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                    Style="{DynamicResource D2StyleRadioButton}"
                    UseLayoutRounding="True"
                    Visibility="{Binding IsPlaceholder, Converter={StaticResource InverseBooleanToVisibilityConverter}}">

                    <Border>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="False">
                                        <Setter Property="Background" Value="Transparent" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Background" Value="#33FFFFFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <TextBlock
                            Margin="15,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            d:FontFamily="Haas Grot Text 55 Roman"
                            FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                            FontSize="19"
                            Foreground="{StaticResource ForegroundColour90}"
                            Text="{Binding ItemCategoryName, Converter={StaticResource CharSpacingConverter}, ConverterParameter=' :1'}"
                            Typography.CapitalSpacing="True">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <!--  Trigger when IsSelected (IsChecked) is false  -->
                                        <DataTrigger Binding="{Binding IsSelected}" Value="False">
                                            <Setter Property="Opacity" Value="0.5" />
                                        </DataTrigger>
                                        <!--  Trigger when IsSelected (IsChecked) is true  -->
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Opacity" Value="1.0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                </RadioButton>

                <!--  Placeholder Rectangle  -->
                <Rectangle Fill="#08FFFFFF" Visibility="{Binding IsPlaceholder, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </DataTemplate>

        <!--  Entry Item templates  -->
        <DataTemplate x:Key="RecordEntryTemplate">
            <Grid Background="Transparent">
                <Grid Background="#1AFFFFFF" Visibility="{Binding IsPlaceholder, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <Button
                        x:Name="RecordItemButton"
                        Margin="0,0,0,0"
                        local:StyleHelper.BorderThickness="0.5"
                        Focusable="False"
                        MouseEnter="CategoryEntryButton_MouseEnter"
                        MouseLeave="PlugItem_MouseLeave"
                        Style="{DynamicResource D2StyleButton}"
                        Visibility="{Binding EntryType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Record}">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>

                            <Rectangle
                                Grid.Row="0"
                                Grid.ColumnSpan="2"
                                VerticalAlignment="Stretch"
                                Stretch="Fill"
                                Visibility="{Binding DataContext.ItemCategoryBackground, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:CategoryView}}, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=False}">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0.5">
                                        <GradientStop Offset="1" Color="#00000000" />
                                        <GradientStop Offset="0" Color="#264dd1ff" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <Grid
                                Grid.Column="0"
                                Margin="20"
                                Background="Transparent">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="50*" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="50*" />
                                </Grid.RowDefinitions>

                                <StackPanel
                                    Grid.Row="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">

                                    <Image
                                        Margin="0,0,10,4"
                                        Opacity="0.75"
                                        Source="{Binding ItemIcon}">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ItemIcon}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>

                                    <TextBlock
                                        Grid.Row="0"
                                        Margin="0,0,0,5"
                                        d:FontFamily="Haas Grot Text 55 Roman"
                                        FontFamily="{DynamicResource Haas Grot Text 65 Medium Keys}"
                                        FontSize="22"
                                        Foreground="{StaticResource ForegroundColour80}"
                                        Text="{Binding ItemName}"
                                        TextWrapping="WrapWithOverflow"
                                        Typography.CapitalSpacing="True" />
                                </StackPanel>

                                <Border
                                    Grid.Row="1"
                                    Margin="0,4,0,4"
                                    BorderBrush="#3AFFFFFF"
                                    BorderThickness="0,0,0,2"
                                    Visibility="Visible" />

                                <Grid
                                    Grid.Row="2"
                                    Margin="0,0,0,0"
                                    Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,0,0"
                                        HorizontalAlignment="Left"
                                        d:FontFamily="Haas Grot Text 55 Roman"
                                        FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                                        FontSize="20"
                                        Foreground="{StaticResource ForegroundColour60}"
                                        Text="{Binding ItemDescription}"
                                        TextTrimming="WordEllipsis"
                                        Typography.CapitalSpacing="True" />

                                    <ItemsControl
                                        Grid.Column="1"
                                        Margin="5,5,0,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        ItemTemplate="{DynamicResource RewardItemTemplate}"
                                        KeyboardNavigation.TabNavigation="None">
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Setter Property="ItemsSource" Value="{Binding Rewards}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Rewards.Count}" Value="0">
                                                        <Setter Property="ItemsSource" Value="{Binding IntervalRewards}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>

                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid
                                                    Grid.Row="0"
                                                    Width="auto"
                                                    Margin="0,0,0,0"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Center"
                                                    Background="Transparent"
                                                    FlowDirection="RightToLeft"
                                                    Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Margin" Value="0,0,4,0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                    </ItemsControl>
                                </Grid>
                            </Grid>

                            <Border
                                Grid.Column="1"
                                Margin="0,0,20,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                BorderBrush="#CCFFFFFF"
                                BorderThickness="2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ItemIcon2}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Image
                                    Width="86"
                                    Height="86"
                                    Source="{Binding ItemIcon2}"
                                    Stretch="Fill" />
                            </Border>

                        </Grid>
                    </Button>
                </Grid>

                <!--  Placeholder Rectangle  -->
                <Rectangle Panel.ZIndex="-1" Fill="#08FFFFFF" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CollectibleEntryTemplate">
            <Grid Background="Transparent">
                <Grid Background="#1AFFFFFF" Visibility="{Binding IsPlaceholder, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <Button
                        x:Name="CollectibleItemButton"
                        Margin="0,0,0,0"
                        local:StyleHelper.BorderThickness="0.5"
                        Focusable="False"
                        MouseEnter="CategoryEntryButton_MouseEnter"
                        MouseLeave="PlugItem_MouseLeave"
                        MouseRightButtonDown="Button_MouseRightButtonDown"
                        Style="{DynamicResource D2StyleButton}"
                        Visibility="{Binding EntryType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Collectible}">

                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Image
                                Margin="0,0,0,0"
                                Opacity="1"
                                Source="{Binding ItemIcon}">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ItemIcon}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>

                            <Grid
                                Width="28"
                                Height="48"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Panel.ZIndex="10"
                                Visibility="{Binding ItemIcon2, Converter={StaticResource NullToVisibilityConverter}}">
                                <Rectangle
                                    Grid.Row="1"
                                    Width="22"
                                    Height="48"
                                    Margin="0,3,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Opacity="0.6"
                                    RenderOptions.EdgeMode="Aliased"
                                    Stretch="Fill">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                            <GradientStop Offset="0" Color="#00000000" />
                                            <GradientStop Offset="1" Color="Black" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>

                                <!--  Featured item banner  -->
                                <Polygon
                                    Width="28"
                                    Height="32"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Fill="#109191"
                                    Points="0,0 0,32 14,28 28,32 28,0">
                                    <Polygon.Style>
                                        <Style TargetType="Polygon">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ItemHash, Converter={StaticResource Investment_IsFeaturedItem}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Polygon.Style>
                                </Polygon>

                                <Image
                                    Width="20"
                                    Height="20"
                                    Margin="0,3,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Source="{Binding ItemIcon2}" />
                            </Grid>


                            <Grid
                                Grid.Column="1"
                                Margin="20,0,0,0"
                                Background="Transparent">


                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="0,20,40,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Panel.ZIndex="1"
                                    FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                                    FontSize="21"
                                    Foreground="{StaticResource ForegroundColour90}"
                                    Text="{Binding ItemName}"
                                    TextAlignment="Left"
                                    TextWrapping="WrapWithOverflow" />

                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="0,0,5,2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Panel.ZIndex="1"
                                    FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                                    FontSize="12"
                                    Foreground="{StaticResource ForegroundColour70}"
                                    Text="{Binding ItemHash}"
                                    TextAlignment="Left"
                                    TextWrapping="Wrap"
                                    Visibility="Visible" />
                            </Grid>
                        </Grid>

                    </Button>
                </Grid>

                <!--  Placeholder Rectangle  -->
                <Rectangle Panel.ZIndex="-1" Fill="#08FFFFFF" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CollectibleSetEntryTemplate">
            <Grid Background="Transparent">
                <Grid Background="#1AFFFFFF" Visibility="{Binding IsPlaceholder, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <Button
                        x:Name="CollectibleSetItemButton"
                        Margin="0,0,0,0"
                        local:StyleHelper.BorderThickness="0.5"
                        Focusable="False"
                        Style="{DynamicResource D2StyleButton}"
                        Visibility="{Binding EntryType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=CollectibleSet}">

                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ItemsControl
                                x:Name="SetEntries"
                                Margin="0,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                ItemsSource="{Binding Children}"
                                KeyboardNavigation.TabNavigation="None">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid
                                            Grid.Row="0"
                                            Width="auto"
                                            Margin="0,0,0,0"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Top"
                                            Background="Transparent"
                                            Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Background="Transparent">
                                            <Button
                                                x:Name="SetEntryItemButton"
                                                Margin="0,0,0,0"
                                                local:StyleHelper.BorderThickness="0.5"
                                                Focusable="False"
                                                MouseEnter="CategoryEntryButton_MouseEnter"
                                                MouseLeave="PlugItem_MouseLeave"
                                                MouseRightButtonDown="Button_MouseRightButtonDown"
                                                Style="{DynamicResource D2StyleButtonNoOverlay}"
                                                Visibility="{Binding IsPlaceholder, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                <Grid Margin="-2" Opacity="1">
                                                    <Image Source="{Binding ItemIcon}">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ItemIcon}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>

                                                    <Grid
                                                        Width="22"
                                                        Height="48"
                                                        Margin="0"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Visibility="{Binding ItemIcon2, Converter={StaticResource NullToVisibilityConverter}}">
                                                        <Rectangle
                                                            Grid.Row="1"
                                                            Width="22"
                                                            Height="48"
                                                            Opacity="0.6"
                                                            Stretch="Fill">
                                                            <Rectangle.Fill>
                                                                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                                    <GradientStop Offset="0" Color="#00000000" />
                                                                    <GradientStop Offset="1" Color="Black" />
                                                                </LinearGradientBrush>
                                                            </Rectangle.Fill>
                                                        </Rectangle>
                                                        <Image
                                                            Width="20"
                                                            Height="20"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Top"
                                                            Source="{Binding ItemIcon2}" />
                                                    </Grid>
                                                </Grid>

                                            </Button>

                                            <!--  Placeholder Rectangle  -->
                                            <Border
                                                Margin="-1"
                                                Panel.ZIndex="-1"
                                                BorderBrush="White"
                                                BorderThickness="1"
                                                Opacity="0.2"
                                                Visibility="{Binding IsPlaceholder, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Rectangle
                                                    Width="1"
                                                    Margin="-20"
                                                    Fill="White">
                                                    <Rectangle.LayoutTransform>
                                                        <TransformGroup>
                                                            <RotateTransform Angle="45" />
                                                        </TransformGroup>
                                                    </Rectangle.LayoutTransform>
                                                </Rectangle>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>

                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Margin" Value="0,0,8,0" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>

                            <Grid
                                Grid.Column="1"
                                Margin="20,0,0,0"
                                Background="Transparent">

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="0,20,40,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Panel.ZIndex="1"
                                    FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                                    FontSize="21"
                                    Foreground="{StaticResource ForegroundColour90}"
                                    Text="{Binding ItemName}"
                                    TextAlignment="Left"
                                    TextWrapping="WrapWithOverflow" />

                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="0,0,5,2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Panel.ZIndex="1"
                                    FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                                    FontSize="12"
                                    Foreground="{StaticResource ForegroundColour70}"
                                    Text="{Binding ItemHash}"
                                    TextAlignment="Left"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Grid>

                    </Button>
                </Grid>

                <!--  Placeholder Rectangle  -->
                <Rectangle Panel.ZIndex="-1" Fill="#08FFFFFF" />
            </Grid>
        </DataTemplate>


        <DataTemplate x:Key="RewardItemTemplate">
            <Image
                MaxWidth="36"
                MaxHeight="36"
                Opacity="0.75"
                Source="{Binding ItemIcon}" />
        </DataTemplate>

        <Storyboard x:Key="TextChangeAnimation">
            <DoubleAnimation
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="1.0"
                Duration="0:0:0.4" />
            <ThicknessAnimation
                Storyboard.TargetProperty="Margin"
                From="30,0,0,0"
                To="0,0,0,0"
                Duration="0:0:0.4">
                <ThicknessAnimation.EasingFunction>
                    <SineEase EasingMode="EaseOut" />
                </ThicknessAnimation.EasingFunction>
            </ThicknessAnimation>
        </Storyboard>

    </UserControl.Resources>

    <Grid
        x:Name="MainGrid"
        Focusable="False"
        Style="{StaticResource GradientBackgroundSemiTransparent}">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Grid.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetProperty="Opacity"
                            From="0"
                            To="1"
                            Duration="0:0:0.25" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <Grid.RowDefinitions>
            <RowDefinition Height="5*" />
            <RowDefinition Height="90*" />
            <RowDefinition Height="5*" />
        </Grid.RowDefinitions>

        <!--  Item Rarity banner  -->
        <Grid
            Name="ItemRarityBanner"
            Grid.Row="0"
            Width="auto"
            VerticalAlignment="Stretch"
            Panel.ZIndex="1"
            Background="Transparent"
            Visibility="{Binding ItemCategoryBackground, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=true}">
            <Grid.RowDefinitions>
                <RowDefinition Height="80*" />
                <RowDefinition Height="20*" />
            </Grid.RowDefinitions>

            <Rectangle
                Grid.Row="0"
                Grid.RowSpan="1"
                Fill="{Binding CategoryBannerColor}"
                Opacity="0.651" />
            <Rectangle
                Grid.Row="1"
                Fill="{Binding CategoryBannerColor}"
                Opacity="0.902" />
        </Grid>

        <!--  Optional background  -->
        <Grid Grid.RowSpan="3" Background="#1d201f">
            <Grid.RowDefinitions>
                <RowDefinition Height="75*" />
                <RowDefinition Height="25*" />
            </Grid.RowDefinitions>

            <Rectangle
                Grid.Row="0"
                VerticalAlignment="Stretch"
                Stretch="Fill">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                        <GradientStop Offset="0" Color="#00000000" />
                        <GradientStop Offset="1" Color="#2100d1d1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Viewbox
                Grid.RowSpan="1"
                Margin="0,0,0,0"
                VerticalAlignment="Top"
                RenderTransformOrigin="0.5,0.5">
                <Image
                    IsHitTestVisible="False"
                    Source="{Binding ItemCategoryBackground}"
                    Stretch="Uniform">
                    <Image.RenderTransform>
                        <TranslateTransform X="0" Y="-405" />
                    </Image.RenderTransform>
                </Image>
            </Viewbox>


            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ItemCategoryBackground}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
        </Grid>

        <Viewbox Grid.RowSpan="3">
            <Grid
                x:Name="MainContainer"
                Width="1920"
                Height="990"
                Background="Transparent"
                ClipToBounds="True"
                RenderTransformOrigin="0.5,0.5"
                SnapsToDevicePixels="True">
                <Grid.RenderTransform>
                    <TranslateTransform />
                </Grid.RenderTransform>

                <Grid.RowDefinitions>
                    <RowDefinition Height="180*" />
                    <RowDefinition Height="700*" />
                    <RowDefinition Height="100*" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150*" />
                    <ColumnDefinition Width="460*" />
                    <ColumnDefinition Width="1400*" />

                </Grid.ColumnDefinitions>

                <Grid
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,5,50,-10"
                    Background="Transparent"
                    Opacity="0.4">
                    <Border
                        Width="10"
                        Height="10"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        BorderBrush="White"
                        BorderThickness="0,0,2,2" />

                    <Border
                        Width="10"
                        Height="10"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        BorderBrush="White"
                        BorderThickness="0,2,2,0" />
                </Grid>

                <Grid
                    Grid.Row="1"
                    Grid.Column="2"
                    Margin="0,5,80,-10"
                    Background="Transparent"
                    Opacity="0.4">
                    <Border
                        Width="10"
                        Height="10"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        BorderBrush="White"
                        BorderThickness="2,0,0,2" />

                    <Border
                        Width="10"
                        Height="10"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        BorderBrush="White"
                        BorderThickness="2,2,0,0" />
                </Grid>



                <!--  Category Header  -->
                <Grid
                    x:Name="Header"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Background="Transparent">
                    <StackPanel Orientation="Horizontal">
                        <Image
                            Width="86"
                            Height="86"
                            d:Source="https://www.bungie.net/common/destiny2_content/icons/7564027686d50ee4438e0f66466f3abc.png"
                            Source="{Binding ItemCategoryIcon2}" />

                        <Grid
                            Margin="15,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="Transparent">
                            <StackPanel>

                                <TextBlock
                                    x:Name="SubcategoryName"
                                    Margin="0,0,0,-5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Panel.ZIndex="1"
                                    d:FontFamily="Haas Grot Text 65 Medium"
                                    d:Text="LORE"
                                    FontFamily="{DynamicResource Haas Grot Text 65 Medium Keys}"
                                    FontSize="44"
                                    Foreground="{StaticResource ForegroundColour90}"
                                    Text="{Binding ItemCategoryName}"
                                    TextAlignment="Left"
                                    TextWrapping="Wrap"
                                    Typography.CapitalSpacing="True" />

                                <TextBlock
                                    x:Name="SubcategoryType"
                                    VerticalAlignment="Top"
                                    Panel.ZIndex="1"
                                    d:FontFamily="Haas Grot Text 55 Roman"
                                    d:Text="THE LIGHT"
                                    FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                                    FontSize="30"
                                    Foreground="{StaticResource BackgroundColour40}"
                                    Typography.CapitalSpacing="True" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!--  Categories/Subcategories  -->
                <Grid
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,15,0,0"
                    Background="Transparent">

                    <Grid
                        Grid.Column="0"
                        Background="Transparent"
                        KeyboardNavigation.TabNavigation="None">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>


                        <ItemsControl
                            x:Name="Categories"
                            Margin="0,0,0,30"
                            VerticalAlignment="Top"
                            ItemTemplate="{StaticResource CategoryItemTemplate}"
                            KeyboardNavigation.TabNavigation="None">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid
                                        Grid.Row="0"
                                        Width="auto"
                                        Margin="0,0,0,0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Top"
                                        Background="Transparent"
                                        Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Margin" Value="3,0,3,0" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>

                        <local:ItemPage
                            x:Name="Subcategories"
                            Grid.Row="1"
                            Margin="0,0,0,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            CollapsePageButtons="True"
                            Columns="1"
                            Expand="True"
                            IsVertical="True"
                            ItemMargin="3,4,3,4"
                            ItemsPerPage="9"
                            UsePlaceholders="True" />
                    </Grid>
                </Grid>

                <!--  Entries  -->
                <Grid
                    Grid.Row="1"
                    Grid.Column="2"
                    Margin="0,15,0,0"
                    Background="Transparent">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*" />
                        <ColumnDefinition Width="100*" />
                        <ColumnDefinition Width="8*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Margin="0,0,5,0"
                        HorizontalAlignment="Right"
                        BorderBrush="#1AFFFFFF"
                        BorderThickness="0,0,2,0"
                        Visibility="Visible" />

                    <Grid Grid.Column="1" Background="Transparent">
                        <local:ItemPage
                            x:Name="SubcategoryItems"
                            CollapsePageButtons="false"
                            Columns="2"
                            ItemMargin="3"
                            ItemsPerPage="10"
                            UsePlaceholders="True" />
                    </Grid>
                </Grid>

            </Grid>
        </Viewbox>

        <!--  User Controls  -->
        <Grid
            Grid.Row="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Background="#38000000">
            <Viewbox HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel
                    Margin="0,10,75,10"
                    FlowDirection="RightToLeft"
                    Orientation="Horizontal">

                    <TextBlock
                        VerticalAlignment="Center"
                        Panel.ZIndex="1"
                        d:FontFamily="Haas Grot Text 55 Roman, Destiny Keys"
                        FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                        FontSize="20"
                        Foreground="{StaticResource ForegroundColour80}"
                        Text=" Dismiss"
                        TextAlignment="Left"
                        TextWrapping="Wrap" />

                </StackPanel>
            </Viewbox>
        </Grid>

    </Grid>

</UserControl>
