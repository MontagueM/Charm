<UserControl
    x:Class="Charm.GeneralConfigView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Charm"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="945"
    d:DesignWidth="1914"
    Loaded="OnControlLoaded"
    mc:Ignorable="d">
    <Grid Background="Transparent">
        <ScrollViewer
            Margin="50,75,50,75"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Resources>
                <Style BasedOn="{StaticResource VerticalScrollBarStyle}" TargetType="ScrollBar">
                    <Setter Property="Width" Value="7" />
                </Style>
            </ScrollViewer.Resources>

            <StackPanel Margin="50,0,50,0" Orientation="Vertical">
                <Grid VerticalAlignment="Top" Background="Transparent">
                    <TextBlock
                        Margin="-50,0,0,10"
                        VerticalAlignment="Center"
                        d:FontFamily="Haas Grot Text 55 Roman"
                        FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                        FontSize="26"
                        Foreground="{StaticResource ForegroundColour70}"
                        Text="💾"
                        TextWrapping="Wrap" />
                    <Border
                        Margin="0,0,0,0"
                        VerticalAlignment="Center"
                        BorderBrush="{StaticResource ForegroundColour70}"
                        BorderThickness="0,0,0,2">
                        <TextBlock
                            Margin="0,0,0,10"
                            VerticalAlignment="Center"
                            d:FontFamily="Haas Grot Text 55 Roman"
                            FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                            FontSize="28"
                            Foreground="{StaticResource ForegroundColour70}"
                            Text="GENERAL"
                            TextWrapping="Wrap" />
                    </Border>
                </Grid>

                <StackPanel
                    x:Name="GeneralConfigPanel"
                    Margin="0,10,0,50"
                    Orientation="Vertical" />

                <Grid VerticalAlignment="Top" Background="Transparent">
                    <TextBlock
                        Margin="-50,0,0,10"
                        VerticalAlignment="Center"
                        d:FontFamily="Haas Grot Text 55 Roman"
                        FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                        FontSize="26"
                        Foreground="{StaticResource ForegroundColour70}"
                        Text="🎨"
                        TextWrapping="Wrap" />
                    <Border
                        Margin="0,0,0,0"
                        VerticalAlignment="Center"
                        BorderBrush="{StaticResource ForegroundColour70}"
                        BorderThickness="0,0,0,2">
                        <TextBlock
                            Margin="0,0,0,10"
                            VerticalAlignment="Center"
                            d:FontFamily="Haas Grot Text 55 Roman"
                            FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                            FontSize="28"
                            Foreground="{StaticResource ForegroundColour70}"
                            Text="MATERIALS"
                            TextWrapping="Wrap" />
                    </Border>
                </Grid>

                <StackPanel
                    x:Name="MaterialsConfigPanel"
                    Margin="0,10,0,50"
                    Orientation="Vertical" />

                <Grid VerticalAlignment="Top" Background="Transparent">
                    <TextBlock
                        Margin="-50,0,0,10"
                        VerticalAlignment="Center"
                        d:FontFamily="Haas Grot Text 55 Roman"
                        FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                        FontSize="26"
                        Foreground="{StaticResource ForegroundColour70}"
                        Text="⚙️"
                        TextWrapping="Wrap" />
                    <Border
                        Margin="0,0,0,0"
                        VerticalAlignment="Center"
                        BorderBrush="{StaticResource ForegroundColour70}"
                        BorderThickness="0,0,0,2">
                        <TextBlock
                            Margin="0,0,0,10"
                            VerticalAlignment="Center"
                            d:FontFamily="Haas Grot Text 55 Roman"
                            FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                            FontSize="28"
                            Foreground="{StaticResource ForegroundColour70}"
                            Text="MISC"
                            TextWrapping="Wrap" />
                    </Border>
                </Grid>

                <StackPanel
                    x:Name="MiscConfigPanel"
                    Margin="0,10,0,50"
                    Orientation="Vertical" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
