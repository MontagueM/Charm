<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
		<Configurations>Release;Debug;</Configurations>
		<Platforms>x64</Platforms>
		<IsPackable>false</IsPackable>
		<Authors />
		<Company>MontagueM</Company>
		<LangVersion>11</LangVersion>
		<ApplicationIcon>charm.ico</ApplicationIcon>
		<RunPostBuildEvent>Always</RunPostBuildEvent>      <SatelliteResourceLanguages></SatelliteResourceLanguages>
    </PropertyGroup>

    <ItemGroup>
      <None Remove="Changelog.json" />
      <None Remove="HLSLSyntax.xshd" />
      <None Remove="Shaders\Holofoil_ps.fx" />
      <None Remove="Shaders\procedural_spinner.vs.cso" />
      <None Remove="Shaders\procedural_spinner.vs.hlsl" />
      <None Remove="Shaders\procedural_spinner_dark.ps.cso" />
