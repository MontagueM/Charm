<UserControl
    x:Class="Charm.Shared.SearchBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Charm.Shared"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Border
        Height="32"
        Background="#2B2B2B"
        BorderBrush="#3F3F3F"
        BorderThickness="1"
        CornerRadius="0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Magnifying glass icon  -->
            <Path
                Grid.Column="0"
                Width="14"
                Height="14"
                Margin="8,0,4,0"
                VerticalAlignment="Center"
                Data="M 9.5,0 C 14.75,0 19,4.25 19,9.5 C 19,11.6 18.3,13.5 17.1,15.05 L 23.7,21.65 C 24.3,22.25 24.3,23.2 23.7,23.8 C 23.1,24.4 22.15,24.4 21.55,23.8 L 15,17.25 C 13.4,18.4 11.5,19 9.5,19 C 4.25,19 0,14.75 0,9.5 C 0,4.25 4.25,0 9.5,0 Z M 9.5,3 C 5.9,3 3,5.9 3,9.5 C 3,13.1 5.9,16 9.5,16 C 13.1,16 16,13.1 16,9.5 C 16,5.9 13.1,3 9.5,3 Z"
                Fill="#888888"
                Stretch="Uniform" />

            <!--  Text input area  -->
            <Grid Grid.Column="1">
                <TextBox
                    x:Name="SearchTextBox"
                    Padding="0,0,8,0"
                    VerticalContentAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    CaretBrush="White"
                    FontSize="13"
                    Foreground="White"
                    TextChanged="SearchTextBox_TextChanged" />

                <TextBlock
                    x:Name="PlaceholderText"
                    Margin="1,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="#888888"
                    IsHitTestVisible="False" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
